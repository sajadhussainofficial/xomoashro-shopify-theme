{%- doc -%}
  One suggested product in the cart, chosen in Theme settings > Cart. Hidden
  when no product is chosen, when it is sold out or when it is already in the
  cart. Uses Horizon's product form, so adding it updates the cart in place.

  @param {string} section_id - Section the cart re-renders (`cart-drawer-section` in the drawer)
  @param {string} [context] - `drawer` or `page`. Defaults to `page`

  @example
  {% render 'xo-cart-upsell', section_id: 'cart-drawer-section', context: 'drawer' %}
{%- enddoc -%}

{%- liquid
  assign xo_up = settings.xo_cart_upsell_product
  assign xo_up_show = false
  if xo_up != blank and xo_up.available
    assign xo_up_show = true
    for item in cart.items
      if item.product_id == xo_up.id
        assign xo_up_show = false
        break
      endif
    endfor
  endif
-%}

{%- if xo_up_show -%}
  {%- liquid
    assign xo_up_context = context | default: 'page'
    assign xo_up_variant = xo_up.selected_or_first_available_variant
    assign xo_up_heading_fallback = 'xo.cart.upsell_heading' | t
    assign xo_up_heading = settings.xo_cart_upsell_heading | default: xo_up_heading_fallback
    assign xo_up_image = xo_up_variant.featured_image | default: xo_up.featured_image
    assign xo_up_form_id = 'XoCartUpsellForm-' | append: xo_up_context
  -%}
  <section
    class="xo-cart-upsell xo-cart-upsell--{{ xo_up_context }}"
    aria-labelledby="XoCartUpsell-{{ xo_up_context }}"
  >
    <h3
      class="xo-eyebrow xo-cart-upsell__heading"
      id="XoCartUpsell-{{ xo_up_context }}"
    >
      {{- xo_up_heading | escape -}}
    </h3>
    <product-form-component
      class="xo-cart-upsell__card"
      data-section-id="{{ section_id }}"
      data-product-id="{{ xo_up.id }}"
      on:submit="/handleSubmit"
    >
      <div
        class="xo-visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      <a
        class="xo-cart-upsell__media"
        href="{{ xo_up.url }}"
        tabindex="-1"
        aria-hidden="true"
      >
        {%- if xo_up_image -%}
          {{- xo_up_image | image_url: width: 160 | image_tag: widths: '72, 120, 160', sizes: '72px', loading: 'lazy', alt: '' -}}
        {%- else -%}
          {%- render 'xo-icon', name: 'jar', size: 24 -%}
        {%- endif -%}
      </a>
      <div class="xo-cart-upsell__info">
        <a
          class="xo-cart-upsell__title"
          href="{{ xo_up.url }}"
        >
          {{- xo_up.title -}}
        </a>
        <p class="xo-cart-upsell__price">
          {{- xo_up_variant.price | money -}}
          {%- unless xo_up.has_only_default_variant %} · {{ xo_up_variant.title }}{% endunless -%}
        </p>
      </div>
      {%- form 'product', xo_up, id: xo_up_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form', class: 'xo-cart-upsell__form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ xo_up_variant.id }}"
        >
        <input
          type="hidden"
          name="quantity"
          value="{{ xo_up_variant.quantity_rule.min | default: 1 }}"
        >
        <add-to-cart-component
          ref="addToCartButtonContainer"
          data-add-to-cart-animation="false"
        >
          <button
            class="xo-btn xo-btn--solid xo-btn--sm"
            type="submit"
            name="add"
            ref="addToCartButton"
            on:click="/handleClick"
            aria-label="{{ 'xo.cart.upsell_add_label' | t: title: xo_up.title | escape }}"
          >
            {{- 'xo.cart.upsell_add' | t -}}
          </button>
        </add-to-cart-component>
      {%- endform -%}
    </product-form-component>
  </section>
{%- endif -%}

{% stylesheet %}
  .xo-cart-upsell {
    display: grid;
    gap: var(--xo-space-3);
  }

  .xo-cart-upsell__card {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--xo-space-3);
    padding: var(--xo-space-3);
    border: 1px solid var(--xo-line);
    border-radius: var(--xo-radius-card);
    background: var(--xo-surface);
  }

  .xo-cart-upsell__media {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: calc(var(--xo-radius-card) * 0.6);
    background: var(--xo-bg);
    color: var(--xo-muted);
    overflow: hidden;
  }

  .xo-cart-upsell__media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .xo-cart-upsell__info {
    display: grid;
    gap: 2px;
    min-inline-size: 0;
  }

  .xo-cart-upsell__title {
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-sm);
    font-weight: 600;
    line-height: 1.3;
    color: var(--xo-fg);
    text-decoration: none;
  }

  .xo-cart-upsell__price {
    margin: 0;
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-sm);
    color: var(--xo-muted);
  }

  .xo-cart-upsell__form {
    margin: 0;
  }
{% endstylesheet %}
