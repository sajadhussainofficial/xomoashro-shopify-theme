        { "value": "mountain", "label": "t:xo.options.icon_mountain" },
        { "value": "cash", "label": "t:xo.options.icon_cash" },
        { "value": "leaf", "label": "t:xo.options.icon_leaf" },
        { "value": "shield", "label": "t:xo.options.icon_shield" },
        { "value": "jar", "label": "t:xo.options.icon_jar" },
        { "value": "truck", "label": "t:xo.options.icon_truck" },
        { "value": "flask", "label": "t:xo.options.icon_flask" }
      ],
      "default": "mountain"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "t:xo.labels.badge_2",
      "default": "Above 16,000 ft"
    },
    {
      "type": "select",
      "id": "badge_3_icon",
      "label": "t:xo.labels.badge_3_icon",
      "options": [
        { "value": "drop", "label": "t:xo.options.icon_drop" },
        { "value": "mountain", "label": "t:xo.options.icon_mountain" },
        { "value": "cash", "label": "t:xo.options.icon_cash" },
        { "value": "leaf", "label": "t:xo.options.icon_leaf" },
        { "value": "shield", "label": "t:xo.options.icon_shield" },
        { "value": "jar", "label": "t:xo.options.icon_jar" },
        { "value": "truck", "label": "t:xo.options.icon_truck" },
        { "value": "flask", "label": "t:xo.options.icon_flask" }
      ],
      "default": "cash"
