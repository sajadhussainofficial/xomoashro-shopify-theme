{%- liquid
  assign product = closest.product
  assign bs = block.settings

  capture xo_guarantee_pill
    render 'xo-fact-text', text: bs.guarantee_pill, requires: 'guarantee'
  endcapture

  assign xo_has_lab = false
  if product.metafields.custom.lab_report != blank or product.metafields.custom.lab_name != blank
    assign xo_has_lab = true
  endif

  assign xo_rating = product.metafields.reviews.rating.value
  assign xo_rating_count = product.metafields.reviews.rating_count.value | default: 0
-%}

<div
  class="xo-pdp-head"
  {{ block.shopify_attributes }}
>
  {%- if bs.show_pills -%}
    {%- if xo_guarantee_pill != blank or xo_has_lab and bs.lab_pill != blank -%}
      <ul
        class="xo-pdp-head__pills"
        role="list"
      >
        {%- if xo_guarantee_pill != blank -%}
          <li class="xo-pdp-head__pill">
            {%- render 'xo-icon', name: 'shield', size: 14 -%}
            <span>{{ xo_guarantee_pill | escape }}</span>
          </li>
        {%- endif -%}
        {%- if xo_has_lab and bs.lab_pill != blank -%}
          <li class="xo-pdp-head__pill">
            {%- render 'xo-icon', name: 'flask', size: 14 -%}
            <span>{{ bs.lab_pill | escape }}</span>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  {%- endif -%}

  <h1 class="xo-h2 xo-pdp-head__title">{{ product.title | escape }}</h1>

  {%- if xo_rating != blank and xo_rating_count > 0 -%}
    {%- liquid
      assign xo_rating_value = xo_rating.rating | round: 1
      assign xo_rating_max = xo_rating.scale_max | default: 5
      assign xo_rating_percent = xo_rating.rating | times: 100.0 | divided_by: xo_rating_max
    -%}
    <a
      class="xo-pdp-head__rating"
      href="#reviews"
    >
      <span
        class="xo-stars"
        style="--xo-stars: {{ xo_rating_percent }}%;"
        aria-hidden="true"
      ></span>
      <span>{{ 'xo.product.rating' | t: rating: xo_rating_value, max: xo_rating_max, count: xo_rating_count }}</span>
    </a>
  {%- endif -%}

  {%- capture xo_badges -%}
    {%- for i in (1..3) -%}
      {%- liquid
        assign xo_badge_text_key = 'badge_' | append: i
        assign xo_badge_icon_key = 'badge_' | append: i | append: '_icon'
        assign xo_badge_text = bs[xo_badge_text_key]
        assign xo_badge_icon = bs[xo_badge_icon_key]
      -%}
      {%- if xo_badge_text != blank -%}
        <li class="xo-pdp-head__badge">
          <span class="xo-pdp-head__badge-icon">
            {%- render 'xo-icon', name: xo_badge_icon, size: 20 -%}
          </span>
          <span>{{ xo_badge_text | escape }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if xo_badges != blank -%}
    <ul
      class="xo-pdp-head__badges"
      role="list"
    >
      {{- xo_badges -}}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .xo-pdp-head {
    display: grid;
    gap: var(--xo-space-3);
  }

  .xo-pdp-head__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--xo-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xo-pdp-head__pill {
    display: inline-flex;
    align-items: center;
    gap: var(--xo-space-1);
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--xo-line-strong);
    border-radius: var(--xo-radius-pill);
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-xs);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--xo-fg);
  }

  .xo-pdp-head__title {
    overflow-wrap: anywhere;
  }

  .xo-pdp-head__rating {
    display: inline-flex;
    align-items: center;
    gap: var(--xo-space-2);
    justify-self: start;
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-sm);
    color: var(--xo-fg);
    text-decoration: none;
  }

  .xo-pdp-head__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--xo-space-3) var(--xo-space-5);
    margin: var(--xo-space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .xo-pdp-head__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--xo-space-2);
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-sm);
    font-weight: 600;
    line-height: 1.3;
    color: var(--xo-fg);
  }

  .xo-pdp-head__badge-icon {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border: 1px solid var(--xo-line-strong);
    border-radius: 50%;
  }
{% endstylesheet %}

