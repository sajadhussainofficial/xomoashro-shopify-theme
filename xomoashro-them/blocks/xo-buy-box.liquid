{%- liquid
  assign product = closest.product
  assign bs = block.settings
  assign xo_variant = product.selected_or_first_available_variant

  assign xo_can_add = false
  assign xo_add_text = 'products.product.unavailable' | t
  if xo_variant
    if xo_variant.available
      assign xo_can_add = true
      if settings.currency_code_enabled_product_pages
        assign xo_add_price = xo_variant.price | money_with_currency
      else
        assign xo_add_price = xo_variant.price | money_without_trailing_zeros
      endif
      assign xo_add_text = 'xo.product.add_with_price' | t: price: xo_add_price
    else
      assign xo_add_text = 'products.product.sold_out' | t
    endif
  endif

  assign xo_form_id = 'XoBuyForm-' | append: section.id
  assign xo_media = xo_variant.featured_media | default: product.featured_media
  if xo_media
    assign xo_media_url = xo_media | image_url: width: 100
  endif

  assign xo_wa_variant = ''
  unless product.has_only_default_variant
    assign xo_wa_variant = ' (' | append: xo_variant.title | append: ')'
  endunless
  assign xo_wa_link = shop.url | append: product.url | append: '?variant=' | append: xo_variant.id
  assign xo_wa_message = 'xo.product.whatsapp_message' | t: title: product.title, variant: xo_wa_variant, url: xo_wa_link
  assign xo_wa_label_fallback = 'xo.product.whatsapp_order' | t
  capture xo_wa_url
    if bs.show_whatsapp
      render 'xo-shop-facts', fact: 'whatsapp_url', message: xo_wa_message
    endif
  endcapture
  assign xo_wa_url = xo_wa_url | strip
-%}

<div
  class="xo-buy-box buy-buttons-block"
  {{ block.shopify_attributes }}
>
  <product-form-component
    class="xo-buy-box__form"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-product-url="{{ product.url }}"
    on:submit="/handleSubmit"
    data-quantity-default="{{ xo_variant.quantity_rule.min | default: 1 }}"
    data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
  >
    <div
      class="xo-visually-hidden"
      aria-live="assertive"
      role="status"
      aria-atomic="true"
      ref="liveRegion"
    ></div>
    {%- form 'product', product, id: xo_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input
        type="hidden"
        name="id"
        ref="variantId"
        value="{{ xo_variant.id }}"
      >
      <div
        class="xo-buy-box__row product-form-buttons"
        ref="productFormButtons"
      >
        <span
          class="xo-buy-box__error product-form-text__error hidden"
          ref="addToCartTextError"
        ></span>
        {%- if bs.show_quantity -%}
          {%- render 'quantity-selector', product: product, block: block, class: 'xo-buy-box__qty' -%}
        {%- endif -%}
        <add-to-cart-component
          class="xo-buy-box__add-wrap"
          ref="addToCartButtonContainer"
          data-product-variant-media="{{ xo_media_url }}"
          data-add-to-cart-animation="{{ settings.add_to_cart_animation }}"
        >
          <button
            class="xo-btn xo-btn--block xo-buy-box__add"
            type="submit"
            name="add"
            ref="addToCartButton"
            on:click="/handleClick"
            {% unless xo_can_add %}
              disabled
            {% endunless %}
          >
            <span class="xo-buy-box__add-text">{{ xo_add_text }}</span>
          </button>
        </add-to-cart-component>
      </div>
    {%- endform -%}
  </product-form-component>

  {%- if xo_wa_url != blank -%}
    <a
      class="xo-btn xo-btn--secondary xo-btn--block xo-buy-box__whatsapp"
      href="{{ xo_wa_url }}"
      target="_blank"
      rel="noopener"
      data-xo-sync="whatsapp-{{ block.id }}"
    >
      {%- render 'xo-icon', name: 'whatsapp', size: 20 -%}
      <span>{{ bs.whatsapp_label | default: xo_wa_label_fallback | escape }}</span>
      <span class="xo-visually-hidden">{{ 'xo.product.opens_new_tab' | t }}</span>
    </a>
  {%- endif -%}

  {%- capture xo_quotes -%}
    {%- for i in (1..3) -%}
      {%- liquid
        assign xo_q_key = 'quote_' | append: i
        assign xo_n_key = 'quote_' | append: i | append: '_name'
        assign xo_q = bs[xo_q_key]
        assign xo_n = bs[xo_n_key]
      -%}
      {%- if xo_q != blank -%}
        <figure
          class="xo-quotes__item"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          <blockquote class="xo-quotes__text">“{{ xo_q | escape }}”</blockquote>
          {%- if xo_n != blank -%}
            <figcaption class="xo-quotes__name">{{ xo_n | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if xo_quotes != blank -%}
    <xo-quotes
      class="xo-quotes"
      data-interval="7000"
    >
      {%- render 'xo-icon', name: 'quote', size: 18, class: 'xo-quotes__icon' -%}
      <div class="xo-quotes__list">{{ xo_quotes }}</div>
    </xo-quotes>
  {%- endif -%}
</div>

{% stylesheet %}
  .xo-buy-box {
    display: grid;
    gap: var(--xo-space-3);
  }

  .xo-buy-box__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--xo-space-2);
    align-items: stretch;
  }

  .xo-buy-box__error:not(.hidden) {
    flex-basis: 100%;
    color: var(--xo-error);
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-sm);
  }

  .xo-buy-box .quantity-selector-wrapper {
    flex: none;
  }

  .xo-buy-box .xo-buy-box__qty.quantity-selector {
    --quantity-selector-width: 8rem;

    flex: none;
    inline-size: var(--quantity-selector-width);
    min-block-size: var(--xo-control-height);
    border: 1px solid var(--xo-line-strong);
    border-radius: var(--xo-radius-pill);
    background: transparent;
    color: var(--xo-fg);
    font-family: var(--xo-font-body);
    font-weight: 600;
  }

  .xo-buy-box .xo-buy-box__qty :is(.quantity-minus, .quantity-plus) {
    inline-size: 2.75rem;
    color: var(--xo-fg);
  }

  .xo-buy-box .xo-buy-box__qty input {
    color: var(--xo-fg);
    font-weight: 600;
  }

  .xo-buy-box__add-wrap {
    display: flex;
    flex: 1 1 12rem;
  }

  .xo-buy-box__add {
    min-block-size: 3.5rem;
    font-size: var(--xo-text-base);
  }

  @media (max-width: 599px) {
    .xo-buy-box .xo-buy-box__qty.quantity-selector {
      --quantity-selector-width: 6.5rem;
    }

    .xo-buy-box .xo-buy-box__qty :is(.quantity-minus, .quantity-plus) {
      inline-size: 2.25rem;
    }

    .xo-buy-box__add-wrap {
      flex-basis: 9rem;
    }

    .xo-buy-box__add {
      padding-inline: var(--xo-space-3);
    }
  }

  .xo-buy-box__add:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .xo-buy-box__whatsapp {
    min-block-size: 3.25rem;
  }

  .xo-quotes {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--xo-space-3);
    margin-block-start: var(--xo-space-2);
    padding: var(--xo-space-4);
    border-radius: var(--xo-radius-card);
    background: var(--xo-surface);
    border: 1px solid var(--xo-line);
  }

  .xo-quotes__icon {
    color: var(--xo-muted);
  }

  .xo-quotes__item {
    margin: 0;
    animation: xo-quote-in var(--xo-duration-slow) var(--xo-ease);
  }

  .xo-quotes__text {
    margin: 0;
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-sm);
    line-height: 1.55;
    color: var(--xo-fg);
  }

  .xo-quotes__name {
    margin-block-start: var(--xo-space-1);
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-xs);
    font-weight: 700;
    color: var(--xo-muted);
  }

  @keyframes xo-quote-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-quotes__item {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.buy_box",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:xo.labels.show_quantity",
      "default": true
    },
    { "type": "header", "content": "t:xo.labels.whatsapp_header" },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "t:xo.labels.show_whatsapp_order",
      "info": "t:xo.info.whatsapp_order",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "t:xo.labels.button_label",
      "default": "Order on WhatsApp"
    },
    { "type": "header", "content": "t:xo.labels.quotes_header" },
    { "type": "paragraph", "content": "t:xo.info.quotes" },
    {
      "type": "textarea",
      "id": "quote_1",
      "label": "t:xo.labels.quote_1",
      "default": "Xomoashro's shilajit is top-notch! The quality is impressive, and their delivery is quick and reliable."
    },
    {
      "type": "text",
      "id": "quote_1_name",
      "label": "t:xo.labels.quote_1_name",
      "default": "Asad"
    },
    {
      "type": "textarea",
      "id": "quote_2",
      "label": "t:xo.labels.quote_2",
      "default": "Xomoashro's shilajit is a game-changer! The quality is outstanding, and their fast delivery makes it a hassle-free experience."
    },
    {
      "type": "text",
      "id": "quote_2_name",
      "label": "t:xo.labels.quote_2_name",
      "default": "Taimoor Khan, professional international boxer"
    },
    {
      "type": "textarea",
      "id": "quote_3",
      "label": "t:xo.labels.quote_3",
      "default": "I'm delighted with the high-quality shilajit from Xomoashro."
    },
    {
      "type": "text",
      "id": "quote_3_name",
      "label": "t:xo.labels.quote_3_name",
      "default": "Abdullah, cricketer"
    }
  ],
  "presets": [{ "name": "t:xo.names.buy_box" }]
}
{% endschema %}
