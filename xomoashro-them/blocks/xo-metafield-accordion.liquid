{%- liquid
  assign product = closest.product
  assign bs = block.settings
  assign xo_fields = product.metafields.custom

  assign xo_text = bs.text
  assign xo_requires = 'none'
  if xo_text contains '[amount]'
    assign xo_requires = 'free_shipping'
  elsif xo_text contains '[days]'
    assign xo_requires = 'guarantee'
  elsif xo_text contains '[delivery]'
    assign xo_requires = 'delivery'
  endif
  capture xo_fallback
    if xo_text != blank
      render 'xo-fact-text', text: xo_text, requires: xo_requires
    endif
  endcapture

  capture xo_body
    case bs.source
      when 'description'
        if product.description != blank
          echo product.description
        else
          echo xo_fallback
        endif
      when 'how_to_use'
        if xo_fields.how_to_use != blank
          echo xo_fields.how_to_use | metafield_tag
        else
          echo xo_fallback
        endif
      when 'safety'
        if xo_fields.safety != blank
          echo xo_fields.safety | metafield_tag
        else
          echo xo_fallback
        endif
      when 'sourcing'
        assign xo_region = xo_fields.origin_region.value
        assign xo_altitude = xo_fields.altitude_ft.value
        if xo_region != blank or xo_altitude != blank
          echo '<dl class="xo-acc__facts">'
          if xo_region != blank
            echo '<div><dt>'
            echo 'xo.product.region' | t
            echo '</dt><dd>'
            echo xo_region | escape
            echo '</dd></div>'
          endif
          if xo_altitude != blank
            echo '<div><dt>'
            echo 'xo.product.altitude' | t
            echo '</dt><dd>'
            echo 'xo.product.altitude_value' | t: feet: xo_altitude
            echo '</dd></div>'
          endif
          echo '</dl>'
        endif
        echo xo_fallback
      when 'inside'
        echo xo_fallback
        assign xo_fulvic = xo_fields.fulvic_percent.value
        if xo_fulvic != blank
          echo '<p>'
          echo 'xo.product.fulvic' | t: percent: xo_fulvic
          echo '</p>'
        endif
      else
        echo xo_fallback
    endcase
  endcapture
-%}

{%- if bs.heading != blank and xo_body != blank -%}
  <details
    class="xo-acc"
    {% if bs.open %}
      open
    {% endif %}
    {% if bs.anchor != blank %}
      id="{{ bs.anchor | handleize }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <summary class="xo-acc__summary">
      {%- if bs.icon != 'none' -%}
        <span class="xo-acc__icon">{%- render 'xo-icon', name: bs.icon, size: 18 -%}</span>
      {%- endif -%}
      <span class="xo-acc__title">{{ bs.heading | escape }}</span>
      {%- render 'xo-icon', name: 'plus', size: 16, class: 'xo-acc__toggle' -%}
    </summary>
    <div class="xo-acc__body xo-rte">{{ xo_body }}</div>
  </details>
{%- endif -%}

{% stylesheet %}
  .xo-acc {
    border-block-end: 1px solid var(--xo-line);
    font-family: var(--xo-font-body);
    color: var(--xo-fg);
  }

  .xo-pdp__info > .xo-acc:first-of-type,
  .xo-acc:not(.xo-acc + .xo-acc) {
    border-block-start: 1px solid var(--xo-line);
  }

  .xo-pdp__info > .xo-acc + .xo-acc {
    margin-block-start: calc(var(--xo-space-5) * -1);
  }

  .xo-acc__summary {
    display: flex;
    align-items: center;
    gap: var(--xo-space-3);
    min-block-size: 3.5rem;
    padding-block: var(--xo-space-3);
    font-size: var(--xo-text-base);
    font-weight: 600;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  .xo-acc__summary::-webkit-details-marker {
    display: none;
  }

  .xo-acc__icon {
    display: grid;
    flex: none;
    place-items: center;
    color: var(--xo-fg);
  }

  .xo-acc__title {
    flex: 1;
  }

  .xo-acc__toggle {
    flex: none;
    transition: transform var(--xo-duration) var(--xo-ease);
  }

  .xo-acc[open] .xo-acc__toggle {
    transform: rotate(45deg);
  }

  .xo-acc__body {
    padding-block-end: var(--xo-space-5);
    font-size: var(--xo-text-sm);
    line-height: 1.65;
    color: var(--xo-fg);
  }

  .xo-acc__body > * + * {
    margin-block-start: var(--xo-space-3);
  }

  .xo-acc__body > :first-child {
    margin-block-start: 0;
  }

  .xo-acc__facts {
    display: grid;
    gap: var(--xo-space-1);
    margin: 0;
  }

  .xo-acc__facts div {
    display: flex;
    gap: var(--xo-space-2);
  }

  .xo-acc__facts dt {
    font-weight: 600;
  }

  .xo-acc__facts dt::after {
    content: ':';
  }

  .xo-acc__facts dd {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-acc__toggle {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.metafield_accordion",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "default": "Details"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:xo.labels.icon",
      "options": [
        { "value": "none", "label": "t:xo.options.icon_none" },
        { "value": "leaf", "label": "t:xo.options.icon_leaf" },
        { "value": "drop", "label": "t:xo.options.icon_drop" },
        { "value": "jar", "label": "t:xo.options.icon_jar" },
        { "value": "mountain", "label": "t:xo.options.icon_mountain" },
        { "value": "shield", "label": "t:xo.options.icon_shield" },
        { "value": "truck", "label": "t:xo.options.icon_truck" },
        { "value": "flask", "label": "t:xo.options.icon_flask" },
        { "value": "clock", "label": "t:xo.options.icon_clock" },
        { "value": "check-circle", "label": "t:xo.options.icon_check_circle" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:xo.labels.accordion_source",
      "info": "t:xo.info.accordion_source",
      "options": [
        { "value": "none", "label": "t:xo.options.source_text" },
        { "value": "description", "label": "t:xo.options.source_description" },
        { "value": "how_to_use", "label": "t:xo.options.source_how_to_use" },
        { "value": "safety", "label": "t:xo.options.source_safety" },
        { "value": "sourcing", "label": "t:xo.options.source_sourcing" },
        { "value": "inside", "label": "t:xo.options.source_inside" }
      ],
      "default": "none"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:xo.labels.fallback_text",
      "info": "t:xo.info.fact_text"
    },
    {
      "type": "checkbox",
      "id": "open",
      "label": "t:xo.labels.open_by_default",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:xo.labels.anchor",
      "info": "t:xo.info.anchor"
    }
  ],
  "presets": [{ "name": "t:xo.names.metafield_accordion" }]
}
{% endschema %}
