{%- liquid
  assign s = section.settings
  assign xo_form_id = 'XoPrelaunch-' | append: section.id
-%}

<div class="xo-prelaunch xo-tone-ink">
  {%- if s.image != blank -%}
    <div
      class="xo-prelaunch__art"
      style="--xo-prelaunch-overlay: {{ s.overlay | divided_by: 100.0 }};"
    >
      {{-
        s.image
        | image_url: width: 2400
        | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '', class: 'xo-prelaunch__image'
      -}}
    </div>
  {%- endif -%}

  <div class="xo-container xo-prelaunch__inner">
    <div class="xo-prelaunch__brand">
      {%- liquid
        assign xo_logo = s.logo | default: settings.logo_inverse
        assign xo_logo_alt = s.brand_name | default: 'Xomoashro'
      -%}
      {%- if xo_logo != blank -%}
        {{-
          xo_logo
          | image_url: width: 480
          | image_tag: widths: '160, 240, 320, 480', sizes: '160px', alt: xo_logo_alt, class: 'xo-prelaunch__logo'
        -}}
      {%- else -%}
        <img
          class="xo-prelaunch__logo"
          src="{{ 'xo-logo-inverse.svg' | asset_url }}"
          alt="{{ xo_logo_alt | escape }}"
          width="160"
          height="32"
        >
      {%- endif -%}
    </div>

    <div class="xo-prelaunch__content">
      {%- if s.eyebrow != blank -%}
        <p class="xo-eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="xo-h1 xo-prelaunch__title">{{ s.heading }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="xo-lead xo-prelaunch__text">{{ shop.password_message | escape }}</p>
      {%- elsif s.text != blank -%}
        <div class="xo-lead xo-prelaunch__text xo-rte">{{ s.text }}</div>
      {%- endif -%}

      {%- if s.show_signup -%}
        {%- form 'customer', id: xo_form_id, class: 'xo-prelaunch__form' -%}
          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter,prelaunch"
          >
          <div class="xo-prelaunch__row">
            <label
              class="xo-visually-hidden"
              for="{{ xo_form_id }}-email"
            >
              {{- 'xo.footer.email_label' | t -}}
            </label>
            <input
              class="xo-field__control xo-prelaunch__input"
              id="{{ xo_form_id }}-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              placeholder="{{ 'xo.password.email_placeholder' | t }}"
              required
              {% if form.errors or form.posted_successfully? %}
                aria-describedby="{{ xo_form_id }}-message"
              {% endif %}
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >
            <button
              class="xo-btn"
              type="submit"
            >
              {{- s.button_label | escape -}}
            </button>
          </div>
          {%- if form.errors -%}
            <p
              class="xo-prelaunch__message xo-prelaunch__message--error"
              id="{{ xo_form_id }}-message"
              role="alert"
            >
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- elsif form.posted_successfully? -%}
            <p
              class="xo-prelaunch__message"
              id="{{ xo_form_id }}-message"
              role="status"
            >
              {%- render 'xo-icon', name: 'check-circle', size: 18 -%}
              {{ s.success_message | escape }}
            </p>
          {%- endif -%}
        {%- endform -%}
        {%- if s.small_print != blank -%}
          <p class="xo-small xo-prelaunch__small">{{ s.small_print | escape }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- if s.show_points -%}
        <ul
          class="xo-prelaunch__points"
          role="list"
        >
          {%- for i in (1..3) -%}
            {%- liquid
              assign xo_point_key = 'point_' | append: i
              assign xo_point_icon_key = 'point_' | append: i | append: '_icon'
              assign xo_point = s[xo_point_key]
            -%}
            {%- if xo_point != blank -%}
              <li>
                {%- render 'xo-icon', name: s[xo_point_icon_key], size: 18 -%}
                <span>{{ xo_point | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .password-main-content:has(.xo-prelaunch) {
    display: block;
    min-block-size: auto;
  }

  .xo-prelaunch {
    position: relative;
    isolation: isolate;
    display: grid;
    min-block-size: calc(100dvh - 4.5rem);
    padding-block: var(--xo-space-6) var(--xo-space-8);
    overflow: hidden;
  }

  .xo-prelaunch__art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .xo-prelaunch__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--xo-ink) 0%, rgb(11 11 13 / 0.85) 45%, rgb(11 11 13 / 0.35) 100%);
    opacity: var(--xo-prelaunch-overlay, 1);
  }

  @media (max-width: 749px) {
    .xo-prelaunch__art::after {
      background: linear-gradient(180deg, rgb(11 11 13 / 0.55) 0%, var(--xo-ink) 70%);
    }
  }

  .xo-prelaunch__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }

  .xo-prelaunch__inner {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--xo-space-7);
  }

  .xo-prelaunch__logo {
    inline-size: 10rem;
    block-size: auto;
  }

  .xo-prelaunch__content {
    display: grid;
    align-content: center;
    gap: var(--xo-space-4);
    max-inline-size: 36rem;
  }

  .xo-prelaunch__title {
    text-wrap: balance;
  }

  .xo-prelaunch__text p {
    margin: 0;
  }

  .xo-prelaunch__form {
    margin-block-start: var(--xo-space-3);
  }

  .xo-prelaunch__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--xo-space-2);
  }

  .xo-prelaunch__row .xo-prelaunch__input {
    flex: 1 1 14rem;
    min-inline-size: 0;
    border-radius: var(--xo-radius-pill);
  }

  @media (max-width: 479px) {
    .xo-prelaunch__row .xo-btn {
      flex: 1 1 100%;
    }
  }

  .xo-prelaunch__message {
    display: flex;
    align-items: center;
    gap: var(--xo-space-2);
    margin: var(--xo-space-3) 0 0;
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-sm);
  }

  .xo-prelaunch__message--error {
    color: var(--xo-error);
  }

  .xo-prelaunch__small {
    color: var(--xo-muted);
  }

  .xo-prelaunch__points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--xo-space-3) var(--xo-space-5);
    margin: var(--xo-space-4) 0 0;
    padding: var(--xo-space-5) 0 0;
    border-block-start: 1px solid var(--xo-line);
    list-style: none;
  }

  .xo-prelaunch__points li {
    display: inline-flex;
    align-items: center;
    gap: var(--xo-space-2);
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-sm);
    font-weight: 600;
  }

  .password-footer {
    background: var(--xo-ink);
    color: var(--xo-on-ink);
    border-block-start: 1px solid color-mix(in srgb, var(--xo-on-ink) 16%, transparent);
  }

  .password-footer a,
  .password-footer button {
    color: inherit;
  }

  .password-footer .password-footer__powered-by :is(a, svg),
  .password-footer .password-footer__links :is(a, button, p) {
    color: var(--xo-on-ink);
  }

  body:has(.xo-prelaunch) {
    background: var(--xo-ink);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.prelaunch",
  "tag": "section",
  "class": "xo-password-section",
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.prelaunch" },
    { "type": "image_picker", "id": "logo", "label": "t:xo.labels.logo", "info": "t:xo.info.prelaunch_logo" },
    { "type": "text", "id": "brand_name", "label": "t:xo.labels.logo_alt", "default": "Xomoashro" },
    { "type": "image_picker", "id": "image", "label": "t:xo.labels.image" },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:xo.labels.overlay",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    { "type": "text", "id": "eyebrow", "label": "t:xo.labels.eyebrow", "default": "Pure Himalayan Aftabi Shilajit" },
    { "type": "inline_richtext", "id": "heading", "label": "t:xo.labels.heading", "default": "Our new store is <em>almost ready</em>" },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:xo.labels.text",
      "info": "t:xo.info.prelaunch_text",
      "default": "<p>Pure shilajit resin from Chitral and Gilgit-Baltistan, delivered across Pakistan with cash on delivery. Leave your email and we will tell you the day we open.</p>"
    },
    { "type": "header", "content": "t:xo.labels.signup_header" },
    { "type": "checkbox", "id": "show_signup", "label": "t:xo.labels.show_signup", "default": true },
    { "type": "text", "id": "button_label", "label": "t:xo.labels.button_label", "default": "Notify me" },
    { "type": "text", "id": "success_message", "label": "t:xo.labels.success_message", "default": "Thank you. We will email you when the store opens." },
    { "type": "text", "id": "small_print", "label": "t:xo.labels.small_print", "default": "No spam. Unsubscribe at any time." },
    { "type": "header", "content": "t:xo.labels.points_header" },
    { "type": "checkbox", "id": "show_points", "label": "t:xo.labels.show_points", "default": true },
    {
      "type": "select",
      "id": "point_1_icon",
      "label": "t:xo.labels.point_1_icon",
      "options": [
        { "value": "cash", "label": "t:xo.options.icon_cash" },
        { "value": "truck", "label": "t:xo.options.icon_truck" },
        { "value": "mountain", "label": "t:xo.options.icon_mountain" },
        { "value": "drop", "label": "t:xo.options.icon_drop" },
        { "value": "shield", "label": "t:xo.options.icon_shield" }
      ],
      "default": "cash"
    },
    { "type": "text", "id": "point_1", "label": "t:xo.labels.point_1", "default": "Cash on delivery" },
    {
      "type": "select",
      "id": "point_2_icon",
      "label": "t:xo.labels.point_2_icon",
      "options": [
        { "value": "cash", "label": "t:xo.options.icon_cash" },
        { "value": "truck", "label": "t:xo.options.icon_truck" },
        { "value": "mountain", "label": "t:xo.options.icon_mountain" },
        { "value": "drop", "label": "t:xo.options.icon_drop" },
        { "value": "shield", "label": "t:xo.options.icon_shield" }
      ],
      "default": "truck"
    },
    { "type": "text", "id": "point_2", "label": "t:xo.labels.point_2", "default": "Delivery across Pakistan" },
    {
      "type": "select",
      "id": "point_3_icon",
      "label": "t:xo.labels.point_3_icon",
      "options": [
        { "value": "cash", "label": "t:xo.options.icon_cash" },
        { "value": "truck", "label": "t:xo.options.icon_truck" },
        { "value": "mountain", "label": "t:xo.options.icon_mountain" },
        { "value": "drop", "label": "t:xo.options.icon_drop" },
        { "value": "shield", "label": "t:xo.options.icon_shield" }
      ],
      "default": "mountain"
    },
    { "type": "text", "id": "point_3", "label": "t:xo.labels.point_3", "default": "Sourced above 16,000 ft" }
  ]
}
{% endschema %}
