{%- liquid
  assign s = section.settings
  assign has_image = false
  assign tone = s.tone
  if s.image != blank
    assign has_image = true
    assign tone = 'ink'
  endif
-%}

{%- if s.heading != blank or section.blocks.size > 0 -%}
  <div
    class="xo-invite xo-tone-{{ tone }}{% if has_image %} xo-invite--media{% endif %}"
    {% if has_image %}
      style="--xo-invite-overlay: {{ s.overlay | divided_by: 100.0 }};"
    {% endif %}
  >
    {%- if has_image -%}
      <div class="xo-invite__media">
        {%- render 'xo-image', image: s.image, sizes: '100vw', max_width: 2400, decorative: true -%}
      </div>
    {%- endif -%}

    <div class="xo-container xo-invite__inner">
      {%- if s.heading != blank -%}
        <h2 class="xo-h2">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.lead != blank -%}
        <div class="xo-lead xo-rte xo-invite__lead">{{ s.lead }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul
          class="xo-invite__links"
          role="list"
        >
          {%- for block in section.blocks -%}
            {%- if block.settings.title != blank -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a
                    class="xo-btn xo-btn--secondary xo-invite__link"
                    href="{{ block.settings.link }}"
                  >
                    {{- block.settings.title | escape -}}
                  </a>
                {%- else -%}
                  <span class="xo-btn xo-btn--secondary xo-invite__link">{{ block.settings.title | escape }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-invite {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .xo-invite__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .xo-invite__media .xo-img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }

  .xo-invite--media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--xo-ink);
    opacity: var(--xo-invite-overlay, 0.65);
  }

  .xo-invite__inner {
    display: grid;
    gap: var(--xo-space-5);
    justify-items: center;
    padding-block: clamp(5rem, 3rem + 9vw, 10rem);
    text-align: center;
  }

  .xo-invite__lead {
    max-inline-size: 36rem;
  }

  .xo-invite--media .xo-invite__lead {
    color: color-mix(in srgb, var(--xo-fg) 86%, transparent);
  }

  .xo-invite__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--xo-space-3);
    margin: var(--xo-space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .xo-invite--media .xo-invite__link {
    --xo-btn-bg: rgb(11 11 13 / 0.45);
    --xo-btn-border: rgb(245 241 234 / 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  @media (hover: hover) {
    .xo-invite--media .xo-invite__link:hover {
      --xo-btn-bg: var(--xo-fg);
      --xo-btn-fg: var(--xo-bg);
      --xo-btn-border: var(--xo-fg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.partners",
  "tag": "section",
  "class": "xo-partners-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "ink"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:xo.labels.background_image",
      "info": "t:xo.info.invite_image"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:xo.labels.overlay",
      "min": 30,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 65,
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "default": "Partner with Xomoashro"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:xo.labels.lead",
      "default": "<p>Grow with us as a distributor, ambassador or affiliate.</p>"
    }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "t:xo.names.partner",
      "settings": [
        { "type": "text", "id": "title", "label": "t:xo.labels.title", "default": "Wholesale" },
        { "type": "url", "id": "link", "label": "t:xo.labels.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.partners",
      "blocks": [
        {
          "type": "partner",
          "settings": { "title": "Wholesale", "link": "/pages/wholesale" }
        },
        {
          "type": "partner",
          "settings": { "title": "Ambassador programme", "link": "/pages/ambassador" }
        },
        {
          "type": "partner",
          "settings": { "title": "Affiliates", "link": "/pages/affiliate" }
        }
      ]
    }
  ]
}
{% endschema %}
