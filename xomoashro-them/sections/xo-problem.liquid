{%- liquid
  assign s = section.settings
  assign tone = s.tone
  assign has_image = false
  if s.image != blank
    assign has_image = true
    assign tone = 'ink'
  endif
-%}

{%- if s.heading != blank or s.text != blank -%}
  <div
    class="xo-problem xo-section xo-tone-{{ tone }}{% if has_image %} xo-problem--media{% endif %}"
    {% if has_image %}
      style="--xo-problem-overlay: {{ s.overlay | divided_by: 100.0 }};"
    {% endif %}
  >
    {%- if has_image -%}
      <div class="xo-problem__media">
        {%- render 'xo-image', image: s.image, sizes: '100vw', max_width: 2400, decorative: true -%}
      </div>
    {%- endif -%}
    <div class="xo-container xo-problem__inner">
      {%- if s.eyebrow != blank -%}
        <p class="xo-eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="xo-h1 xo-problem__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="xo-lead xo-muted xo-rte xo-problem__text">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.button_link != blank -%}
        {%- render 'xo-button', label: s.button_label, url: s.button_link, style: 'secondary', icon: 'arrow-right' -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-problem__inner {
    display: grid;
    gap: var(--xo-space-5);
    justify-items: start;
  }

  .xo-problem__heading {
    max-inline-size: 22ch;
  }

  .xo-problem__text {
    max-inline-size: 40rem;
  }

  .xo-problem--media {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .xo-problem__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .xo-problem__media .xo-img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .xo-problem__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--xo-ink);
    opacity: var(--xo-problem-overlay, 0.55);
  }

  /* Over a picture, body text uses the full text colour to keep its contrast. */
  .xo-problem--media .xo-problem__text {
    color: var(--xo-fg);
  }

  @media (min-width: 750px) {
    .xo-problem__inner {
      justify-items: center;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.problem",
  "tag": "section",
  "class": "xo-problem-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "ink"
    },
    { "type": "text", "id": "eyebrow", "label": "t:xo.labels.eyebrow", "default": "Why we started" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "We found that most shilajit on the market was <em>fake or diluted</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:xo.labels.text",
      "default": "<p>So we set out to offer a trusted alternative: pure resin, sourced directly, with nothing added.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:xo.labels.button_label", "default": "Our source" },
    { "type": "url", "id": "button_link", "label": "t:xo.labels.button_link" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:xo.labels.background_image",
      "info": "t:xo.info.statement_image"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:xo.labels.overlay",
      "min": 30,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55,
      "visible_if": "{{ section.settings.image != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.problem",
      "settings": { "button_link": "/pages/our-source" }
    }
  ]
}
{% endschema %}
