{%- liquid
  assign s = section.settings
  assign found = section.blocks | where: 'type', 'found'
  assign promises = section.blocks | where: 'type', 'promise'
  assign card_tone = 'ink'
  if s.tone == 'ink'
    assign card_tone = 'bone'
  endif
-%}

{%- if s.heading != blank or section.blocks.size > 0 -%}
  <div class="xo-found xo-section xo-tone-{{ s.tone }}">
    <div class="xo-container">
      {%- if s.draft and request.design_mode -%}
        <p class="xo-editor-note xo-draft-note">{{ 'xo.editor.draft' | t }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="xo-h2 xo-found__heading">{{ s.heading }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="xo-found__pair">
          {%- if found.size > 0 -%}
            <div class="xo-found__card xo-found__card--found">
              {%- if s.found_title != blank -%}
                <p class="xo-found__title">{{ s.found_title | escape }}</p>
              {%- endif -%}
              <ul
                class="xo-found__list"
                role="list"
              >
                {%- for block in found -%}
                  <li {{ block.shopify_attributes }}>
                    {%- render 'xo-icon', name: 'minus', size: 20 -%}
                    <span>{{ block.settings.text | escape }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if found.size > 0 and promises.size > 0 -%}
            <span
              class="xo-found__arrow"
              aria-hidden="true"
            >
              {%- render 'xo-icon', name: 'arrow-right', size: 20 -%}
            </span>
          {%- endif -%}

          {%- if promises.size > 0 -%}
            <div class="xo-found__card xo-tone-{{ card_tone }}">
              {%- if s.promise_title != blank -%}
                <p class="xo-found__title">{{ s.promise_title | escape }}</p>
              {%- endif -%}
              <ul
                class="xo-found__list"
                role="list"
              >
                {%- for block in promises -%}
                  <li {{ block.shopify_attributes }}>
                    {%- render 'xo-icon', name: 'check', size: 20 -%}
                    <span>{{ block.settings.text | escape }}</span>
                  </li>
                {%- endfor -%}
              </ul>
              {%- if s.button_link != blank -%}
                {%- render 'xo-button', label: s.button_label, url: s.button_link, style: 'secondary' -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-found__heading {
    max-inline-size: 19ch;
    margin-block-end: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 4.75rem);
    letter-spacing: -0.04em;
    line-height: 1.04;
  }

  .xo-found__pair {
    display: grid;
    gap: var(--xo-space-4);
  }

  .xo-found__card {
    display: grid;
    gap: var(--xo-space-4);
    align-content: start;
    justify-items: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--xo-radius-card);
  }

  .xo-found__card--found {
    border: 1px solid var(--xo-line-strong);
  }

  .xo-found__title {
    margin: 0;
    color: var(--xo-muted);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .xo-found__list {
    display: grid;
    inline-size: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xo-found__list li {
    display: flex;
    gap: var(--xo-space-3);
    align-items: flex-start;
    padding-block: 0.875rem;
    border-block-start: 1px solid var(--xo-line);
    color: var(--xo-fg);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .xo-found__card--found .xo-found__list li {
    color: var(--xo-muted);
  }

  .xo-found__list .xo-icon {
    margin-block-start: 0.125rem;
  }

  .xo-found__arrow {
    display: grid;
    place-items: center;
    justify-self: center;
    inline-size: 3rem;
    block-size: 3rem;
    border: 1px solid var(--xo-line-strong);
    border-radius: 50%;
    color: var(--xo-fg);
    transform: rotate(90deg);
  }

  @media (min-width: 900px) {
    .xo-found__pair {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--xo-space-5);
    }

    .xo-found__arrow {
      align-self: center;
      transform: none;
    }

    [dir='rtl'] .xo-found__arrow {
      transform: scaleX(-1);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.problem",
  "tag": "section",
  "class": "xo-problem-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 10,
  "settings": [
    {
      "type": "checkbox",
      "id": "draft",
      "label": "t:xo.labels.draft",
      "info": "t:xo.info.draft",
      "default": true
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "bone"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "We found that most shilajit on the market was <em>fake or diluted.</em>"
    },
    { "type": "text", "id": "found_title", "label": "t:xo.labels.found_title", "default": "What we found" },
    { "type": "text", "id": "promise_title", "label": "t:xo.labels.promise_title", "default": "What we do" },
    { "type": "text", "id": "button_label", "label": "t:xo.labels.button_label", "default": "Our source" },
    { "type": "url", "id": "button_link", "label": "t:xo.labels.button_link" }
  ],
  "blocks": [
    {
      "type": "found",
      "name": "t:xo.names.found",
      "settings": [
        { "type": "text", "id": "text", "label": "t:xo.labels.text", "default": "Fake or diluted resin" }
      ]
    },
    {
      "type": "promise",
      "name": "t:xo.names.promise",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:xo.labels.text",
          "default": "Pure resin with nothing added"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.problem",
      "settings": { "button_link": "/pages/our-source" },
      "blocks": [
        {
          "type": "found",
          "settings": { "text": "Fake or diluted resin" }
        },
        {
          "type": "found",
          "settings": { "text": "Fillers and binders that are not always stated" }
        },
        {
          "type": "found",
          "settings": { "text": "A source that is often not stated" }
        },
        {
          "type": "promise",
          "settings": { "text": "Pure resin with nothing added" }
        },
        {
          "type": "promise",
          "settings": { "text": "Sourced directly from local collectors" }
        },
        {
          "type": "promise",
          "settings": { "text": "From Chitral and Gilgit-Baltistan" }
        }
      ]
    }
  ]
}
{% endschema %}
