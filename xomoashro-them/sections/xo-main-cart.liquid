{%- liquid
  assign s = section.settings
  assign xo_page_heading_id = 'XoCartHeading-' | append: section.id
  assign xo_page_total = cart.total_price | money | strip_html
  if cart.empty?
    assign xo_page_status = 'xo.cart.status_empty' | t
  else
    assign xo_page_status = 'xo.cart.status' | t: count: cart.item_count, total: xo_page_total
  endif

  assign xo_continue_url = routes.all_products_collection_url
  if collections.all.products_count == 1
    assign xo_continue_url = collections.all.products.first.url
  endif
  assign xo_heading_fallback = 'xo.cart.title' | t
  assign xo_heading = s.heading | default: xo_heading_fallback
-%}

<script
  src="{{ 'component-cart-items.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'component-cart-quantity-selector.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{%- if settings.show_cart_note -%}
  <script
    src="{{ 'cart-note.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- endif -%}

{%- capture xo_page_empty -%}
  <div class="xo-container xo-container--narrow">
    {% render 'xo-cart-empty', heading_id: xo_page_heading_id, context: 'page' %}
  </div>
{%- endcapture -%}

{%- capture xo_page_children -%}
  <template id="empty-cart-template">
    {{- xo_page_empty -}}
  </template>
  <p
    class="xo-visually-hidden"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    {{- xo_page_status -}}
  </p>

  {%- if cart.empty? -%}
    {{ xo_page_empty }}
  {%- else -%}
    <div class="xo-container">
      <header class="xo-cart-page__head">
        <h1
          class="xo-h2 xo-cart-page__title"
          id="{{ xo_page_heading_id }}"
        >
          {{- xo_heading | escape }}
          <span class="xo-cart-page__count">{{ 'xo.cart.item_count' | t: count: cart.item_count }}</span>
        </h1>
        {%- if s.show_continue -%}
          <a
            class="xo-link xo-cart-page__continue"
            href="{{ xo_continue_url }}"
          >
            {{- 'xo.cart.continue' | t -}}
          </a>
        {%- endif -%}
      </header>

      <div class="xo-cart-page__grid">
        <div class="xo-cart-page__main">
          {%- capture xo_page_ship -%}
            {%- render 'xo-free-shipping-bar' -%}
          {%- endcapture -%}
          {%- if xo_page_ship != blank -%}
            <div class="xo-cart-page__ship">{{ xo_page_ship }}</div>
          {%- endif -%}

          {% render 'xo-cart-lines', context: 'page' %}

          {%- capture xo_page_upsell -%}
            {%- render 'xo-cart-upsell', section_id: section.id, context: 'page' -%}
          {%- endcapture -%}
          {%- if xo_page_upsell != blank -%}
            <div class="xo-cart-page__upsell">{{ xo_page_upsell }}</div>
          {%- endif -%}
        </div>

        <aside
          class="xo-cart-page__aside"
          aria-labelledby="XoCartSummary-{{ section.id }}"
        >
          <div class="xo-cart-page__summary">
            <h2
              class="xo-h4"
              id="XoCartSummary-{{ section.id }}"
            >
              {{- 'xo.cart.summary_heading' | t -}}
            </h2>
            {% render 'xo-cart-summary', section_id: section.id, context: 'page' %}
          </div>
        </aside>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="xo-cart-page__apps">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div class="xo-section xo-section--tight xo-tone-{{ s.tone }} xo-cart-page">
  {% render 'cart-items-component', children: xo_page_children, section_id: section.id %}
</div>

{% stylesheet %}
  .xo-cart-page {
    font-family: var(--xo-font-body);
  }

  .xo-cart-page__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--xo-space-3) var(--xo-space-5);
    padding-block-end: var(--xo-space-5);
    margin-block-end: var(--xo-space-5);
    border-block-end: 1px solid var(--xo-line);
  }

  .xo-cart-page__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--xo-space-3);
  }

  .xo-cart-page__count {
    font-family: var(--xo-font-body);
    font-size: var(--xo-text-base);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--xo-muted);
  }

  .xo-cart-page__grid {
    display: grid;
    gap: var(--xo-space-6);
    align-items: start;
  }

  @media (min-width: 990px) {
    .xo-cart-page__grid {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 25rem);
      gap: var(--xo-space-7);
    }
  }

  .xo-cart-page__main {
    display: grid;
    gap: var(--xo-space-5);
    min-inline-size: 0;
  }

  .xo-cart-page__ship {
    padding: var(--xo-space-4) var(--xo-space-5);
    border: 1px solid var(--xo-line);
    border-radius: var(--xo-radius-card);
    background: var(--xo-surface);
  }

  .xo-cart-page__summary {
    display: grid;
    gap: var(--xo-space-4);
    padding: var(--xo-space-5);
    border: 1px solid var(--xo-line);
    border-radius: var(--xo-radius-card);
    background: var(--xo-surface);
  }

  @media (min-width: 750px) {
    .xo-cart-page__summary {
      padding: var(--xo-space-6);
    }
  }

  @media (min-width: 990px) {
    .xo-cart-page__aside {
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--xo-space-5));
    }
  }

  .xo-cart-page__apps {
    margin-block-start: var(--xo-space-7);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.main_cart",
  "tag": "section",
  "class": "xo-main-cart-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.main_cart" },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" }
      ],
      "default": "bone"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "default": "Your cart"
    },
    {
      "type": "checkbox",
      "id": "show_continue",
      "label": "t:xo.labels.show_continue",
      "default": true
    }
  ]
}
{% endschema %}
