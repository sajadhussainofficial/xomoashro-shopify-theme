{%- liquid
  assign s = section.settings
  assign has_media = false
  if s.image != blank
    assign has_media = true
  endif
-%}

{%- if section.blocks.size > 0 -%}
  <div
    class="xo-routine xo-section xo-tone-{{ s.tone }}"
    {% if s.anchor != blank %}
      id="{{ s.anchor | handleize }}"
      data-xo-anchor
    {% endif %}
  >
    <div class="xo-container xo-routine__grid{% if has_media %} xo-routine__grid--media{% endif %}">
      {%- if has_media -%}
        <div class="xo-media xo-routine__pic">
          {%- render 'xo-image', image: s.image, sizes: '(min-width: 990px) 45vw, 100vw' -%}
        </div>
      {%- endif -%}

      <div class="xo-routine__body">
        {%- if s.draft and request.design_mode -%}
        <p class="xo-editor-note xo-draft-note">{{ 'xo.editor.draft' | t }}</p>
      {%- endif -%}
        {%- render 'xo-section-heading', heading: s.heading, lead: s.lead, rule: false -%}

        <ol
          class="xo-routine__steps"
          role="list"
        >
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span
                class="xo-routine__n"
                aria-hidden="true"
              >
                {{- forloop.index -}}
              </span>
              <div class="xo-feature">
                {%- if block.settings.title != blank -%}
                  <h3 class="xo-feature__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="xo-feature__text xo-rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>

        {%- if s.button_link != blank or s.footnote != blank -%}
          <div class="xo-routine__foot">
            {%- if s.button_link != blank -%}
              {%- render 'xo-button', label: s.button_label, url: s.button_link, style: 'solid' -%}
            {%- endif -%}
            {%- if s.footnote != blank -%}
              <p class="xo-footnote">{{ s.footnote | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-routine__grid {
    display: grid;
    gap: var(--xo-space-6);
  }

  .xo-routine__grid:not(.xo-routine__grid--media) {
    max-inline-size: 48rem;
  }

  .xo-routine__pic {
    aspect-ratio: 4 / 3;
  }

  .xo-routine__pic .xo-img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }

  .xo-routine__body {
    display: grid;
    gap: var(--xo-space-6);
    align-content: center;
  }

  .xo-routine__body .xo-heading {
    margin-block-end: 0;
  }

  .xo-routine__steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xo-routine__steps li {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--xo-space-5);
    padding-block-end: var(--xo-space-6);
  }

  .xo-routine__steps li:last-child {
    padding-block-end: 0;
  }

  .xo-routine__steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-block: 3rem 0.25rem;
    inset-inline-start: 1.375rem;
    inline-size: 1px;
    background: var(--xo-line-strong);
  }

  .xo-routine__n {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    background: var(--xo-fg);
    color: var(--xo-bg);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .xo-routine__steps .xo-feature {
    gap: var(--xo-space-1);
    padding-block-start: 0.375rem;
  }

  .xo-routine__foot {
    display: grid;
    gap: var(--xo-space-4);
    justify-items: start;
  }

  .xo-routine__foot .xo-footnote {
    max-inline-size: 32rem;
    margin: 0;
  }

  @media (min-width: 990px) {
    .xo-routine__grid--media {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }

    .xo-routine__pic {
      position: sticky;
      inset-block-start: calc(var(--header-height, 4.5rem) + var(--xo-space-5));
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.how_to_use",
  "tag": "section",
  "class": "xo-howto-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "draft",
      "label": "t:xo.labels.draft",
      "info": "t:xo.info.draft",
      "default": true
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "bone"
    },
    { "type": "image_picker", "id": "image", "label": "t:xo.labels.image", "info": "t:xo.info.howto_image" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "Three steps, <em>once a day</em>"
    },
    { "type": "richtext", "id": "lead", "label": "t:xo.labels.lead" },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:xo.labels.button_label",
      "default": "Read the full guide"
    },
    { "type": "url", "id": "button_link", "label": "t:xo.labels.button_link" },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:xo.labels.footnote",
      "default": "Speak to your doctor before use if you are pregnant, breastfeeding, taking medication or have a health condition."
    },
    { "type": "text", "id": "anchor", "label": "t:xo.labels.anchor", "info": "t:xo.info.anchor" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:xo.names.step",
      "settings": [
        { "type": "text", "id": "title", "label": "t:xo.labels.title", "default": "Take a pea-sized amount" },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:xo.labels.text",
          "default": "<p>Scoop a small portion of resin with a clean, dry spoon.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.how_to_use",
      "settings": { "button_link": "/pages/how-to-use" },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Take a pea-sized amount",
            "text": "<p>Scoop a small portion of resin with a clean, dry spoon.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Dissolve it",
            "text": "<p>Stir it into warm water, milk or tea until it has dissolved.</p>"
          }
        },
        {
          "type": "step",
          "settings": { "title": "Drink once a day", "text": "<p>Start small and keep to the amount on the label.</p>" }
        }
      ]
    }
  ]
}
{% endschema %}
