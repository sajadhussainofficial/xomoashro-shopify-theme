{%- liquid
  assign s = section.settings
  assign blog = s.blog
  if blog == blank
    assign blog = blogs.journal
  endif
  assign article_count = blog.articles_count | default: 0 | plus: 0
-%}

{%- if article_count > 0 -%}
  <div class="xo-journal xo-section xo-tone-{{ s.tone }}">
    <div class="xo-container">
      <div class="xo-journal__top">
        {%- render 'xo-section-heading', eyebrow: s.eyebrow, heading: s.heading, lead: s.lead -%}
        {%- if s.link_label != blank -%}
          <a
            class="xo-btn xo-btn--quiet xo-journal__all"
            href="{{ blog.url }}"
          >
            <span>{{ s.link_label | escape }}</span>
            {%- render 'xo-icon', name: 'arrow-right', size: 18 -%}
          </a>
        {%- endif -%}
      </div>

      <ul
        class="xo-grid xo-journal__list"
        role="list"
        style="--xo-cols-md: 2; --xo-cols-lg: {{ s.count | at_most: 3 }};"
      >
        {%- for article in blog.articles limit: s.count -%}
          <li
            class="xo-journal__card"
            data-xo-reveal
            style="--xo-reveal-order: {{ forloop.index0 }};"
          >
            {%- if article.image != blank -%}
              <a
                class="xo-media xo-journal__media"
                href="{{ article.url }}"
                tabindex="-1"
                aria-hidden="true"
              >
                {%- render 'xo-image', image: article.image, sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', max_width: 1280, decorative: true -%}
              </a>
            {%- endif -%}
            {%- if s.show_date -%}
              <p class="xo-small xo-muted xo-journal__date">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{- article.published_at | date: '%-d %B %Y' -}}
                </time>
              </p>
            {%- endif -%}
            <h3 class="xo-h4 xo-journal__title">
              <a href="{{ article.url }}">{{ article.title | escape }}</a>
            </h3>
            {%- if s.show_excerpt -%}
              <p class="xo-text xo-muted xo-journal__excerpt">
                {{- article.excerpt_or_content | strip_html | truncatewords: 22 -}}
              </p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="xo-section xo-section--tight xo-tone-{{ s.tone }}">
    <div class="xo-container">
      <p class="xo-editor-note">{{ 'xo.journal.empty' | t }}</p>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-journal__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--xo-space-4) var(--xo-space-6);
    margin-block-end: var(--xo-space-7);
  }

  .xo-journal__top .xo-heading {
    margin-block-end: 0;
  }

  .xo-journal__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xo-journal__card {
    display: grid;
    gap: var(--xo-space-3);
    align-content: start;
  }

  .xo-journal__media {
    display: block;
    aspect-ratio: 3 / 2;
    margin-block-end: var(--xo-space-2);
  }

  .xo-journal__media img {
    transition: transform var(--xo-duration-slow) var(--xo-ease);
  }

  .xo-journal__card:hover .xo-journal__media img {
    transform: scale(1.03);
  }

  .xo-journal__date,
  .xo-journal__excerpt {
    margin: 0;
  }

  .xo-journal__title a {
    color: inherit;
    text-decoration: none;
  }

  .xo-journal__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-journal__media img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.journal",
  "tag": "section",
  "class": "xo-journal-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.journal" },
    { "type": "blog", "id": "blog", "label": "t:xo.labels.blog" },
    {
      "type": "range",
      "id": "count",
      "label": "t:xo.labels.post_count",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "bone"
    },
    { "type": "text", "id": "eyebrow", "label": "t:xo.labels.eyebrow", "default": "Journal" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "Learn more about <em>shilajit</em>"
    },
    { "type": "richtext", "id": "lead", "label": "t:xo.labels.lead" },
    { "type": "text", "id": "link_label", "label": "t:xo.labels.link_label", "default": "All articles" },
    { "type": "checkbox", "id": "show_date", "label": "t:xo.labels.show_date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "t:xo.labels.show_excerpt", "default": true }
  ],
  "presets": [
    { "name": "t:xo.names.journal" }
  ]
}
{% endschema %}
