{%- liquid
  assign s = section.settings
  assign blog = s.blog
  if blog == blank
    assign blog = blogs.journal
  endif
  assign article_count = blog.articles_count | default: 0 | plus: 0
-%}

{%- if article_count > 0 -%}
  <div class="xo-reads xo-section xo-tone-{{ s.tone }}">
    <div class="xo-container">
      <div class="xo-reads__top">
        {%- if s.heading != blank -%}
          <h2 class="xo-h2">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.link_label != blank -%}
          <a
            class="xo-link xo-reads__all"
            href="{{ blog.url }}"
          >
            {{- s.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <ul
        class="xo-reads__grid"
        role="list"
      >
        {%- for article in blog.articles limit: s.count -%}
          <li>
            <a
              class="xo-reads__card{% if article.image == blank %} xo-reads__card--plain{% endif %}"
              href="{{ article.url }}"
            >
              {%- if article.image != blank -%}
                {%- render 'xo-image', image: article.image, sizes: '(min-width: 800px) 33vw, 100vw', max_width: 1280, decorative: true -%}
              {%- endif -%}
              <span class="xo-reads__text">
                <span class="xo-reads__title">{{ article.title | escape }}</span>
                {%- if s.read_label != blank -%}
                  <span class="xo-reads__more">{{ s.read_label | escape }}</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="xo-section xo-section--tight xo-tone-{{ s.tone }}">
    <div class="xo-container">
      <p class="xo-editor-note">{{ 'xo.journal.empty' | t }}</p>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-reads__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--xo-space-4) var(--xo-space-6);
    margin-block-end: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .xo-reads__all {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--xo-tap-target);
    font-weight: 600;
  }

  .xo-reads__grid {
    display: grid;
    gap: var(--xo-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xo-reads__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--xo-radius-card);
    background: var(--xo-surface);
    color: #F5F1EA;
    text-decoration: none;
  }

  .xo-reads__card .xo-img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 500ms var(--xo-ease);
  }

  .xo-reads__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(11 11 13 / 0.94) 0%, rgb(11 11 13 / 0.55) 38%, rgb(11 11 13 / 0) 66%);
  }

  .xo-reads__card--plain {
    border: 1px solid var(--xo-line);
    color: var(--xo-fg);
  }

  .xo-reads__card--plain::after {
    display: none;
  }

  .xo-reads__text {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: grid;
    gap: 0.625rem;
    padding: var(--xo-space-5);
  }

  .xo-reads__title {
    font-family: var(--xo-font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: var(--xo-font-display-weight);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .xo-reads__more {
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @media (hover: hover) {
    .xo-reads__card:hover .xo-img {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-reads__card .xo-img {
      transition: none;
    }
  }

  @media (min-width: 800px) {
    .xo-reads__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--xo-space-5);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.journal",
  "tag": "section",
  "class": "xo-journal-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.journal" },
    { "type": "blog", "id": "blog", "label": "t:xo.labels.blog" },
    {
      "type": "range",
      "id": "count",
      "label": "t:xo.labels.post_count",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "ink"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "Learn more about <em>shilajit</em>"
    },
    { "type": "text", "id": "link_label", "label": "t:xo.labels.link_label", "default": "All articles" },
    { "type": "text", "id": "read_label", "label": "t:xo.labels.read_label", "default": "Read the article" }
  ],
  "presets": [
    { "name": "t:xo.names.journal" }
  ]
}
{% endschema %}
