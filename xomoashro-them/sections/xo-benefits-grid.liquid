{%- liquid
  assign s = section.settings
  assign half = section.blocks.size | plus: 1 | divided_by: 2
-%}

{%- if section.blocks.size > 0 -%}
  <div class="xo-orbit xo-section xo-tone-{{ s.tone }}">
    <div class="xo-container">
      {%- render 'xo-section-heading', heading: s.heading, lead: s.lead, align: 'center', rule: false -%}

      <div class="xo-orbit__ring">
        <ul
          class="xo-orbit__col xo-orbit__col--start"
          role="list"
        >
          {%- for block in section.blocks limit: half -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}
                <span class="xo-orbit__icon">{%- render 'xo-icon', name: block.settings.icon -%}</span>
              {%- endif -%}
              <div class="xo-feature">
                <h3 class="xo-feature__title">{{ block.settings.title | escape }}</h3>
                <div class="xo-feature__text xo-rte">{{ block.settings.text }}</div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="xo-orbit__centre">
          {%- if s.image != blank -%}
            {%- render 'xo-image', image: s.image, sizes: '(min-width: 990px) 400px, 320px', widths: '320, 480, 640, 800', max_width: 800 -%}
          {%- else -%}
            <div class="xo-art xo-orbit__art">
              {{- 'xo-art-mountains.svg' | inline_asset_content -}}
            </div>
          {%- endif -%}
        </div>

        <ul
          class="xo-orbit__col"
          role="list"
        >
          {%- for block in section.blocks offset: half -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}
                <span class="xo-orbit__icon">{%- render 'xo-icon', name: block.settings.icon -%}</span>
              {%- endif -%}
              <div class="xo-feature">
                <h3 class="xo-feature__title">{{ block.settings.title | escape }}</h3>
                <div class="xo-feature__text xo-rte">{{ block.settings.text }}</div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- if s.footnote != blank -%}
        <p class="xo-footnote xo-orbit__note">{{ s.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-orbit__ring {
    display: grid;
    gap: var(--xo-space-6);
  }

  .xo-orbit__centre {
    order: -1;
    justify-self: center;
    inline-size: min(100% - 2rem, 20rem);
    aspect-ratio: 1 / 1;
    margin: 1rem;
    overflow: hidden;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--xo-line-strong), 0 0 0 0.875rem var(--xo-bg), 0 0 0 calc(0.875rem + 1px) var(--xo-line);
  }

  .xo-orbit__centre .xo-img,
  .xo-orbit__art {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    border: 0;
    border-radius: 0;
  }

  .xo-orbit__col {
    display: grid;
    align-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xo-orbit__col li {
    display: flex;
    gap: var(--xo-space-4);
    align-items: flex-start;
    padding-block: var(--xo-space-5);
  }

  .xo-orbit__col li + li {
    border-block-start: 1px solid var(--xo-line);
  }

  .xo-orbit__col .xo-feature {
    gap: var(--xo-space-2);
  }

  .xo-orbit__icon {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--xo-line-strong);
    border-radius: 50%;
    color: var(--xo-fg);
  }

  @media (max-width: 989px) {
    .xo-orbit__ring {
      gap: 0;
    }

    .xo-orbit__centre {
      margin-block-end: var(--xo-space-6);
    }

    .xo-orbit__col:last-child li:first-child {
      border-block-start: 1px solid var(--xo-line);
    }
  }

  .xo-orbit__note {
    max-inline-size: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  @media (min-width: 990px) {
    .xo-orbit__ring {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem) minmax(0, 1fr);
      gap: var(--xo-space-8);
      align-items: center;
    }

    .xo-orbit__centre {
      order: 0;
      inline-size: auto;
      margin: 0;
    }

    .xo-orbit__col--start li {
      flex-direction: row-reverse;
      text-align: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.benefits",
  "tag": "section",
  "class": "xo-benefits-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 8,
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.orbit" },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "bone"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "An ancient remedy for <em>everyday well-being</em>"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:xo.labels.lead",
      "default": "<p>Shilajit is a natural mineral resin with a long history in Ayurvedic tradition. Here is what people have taken it for.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "t:xo.labels.image", "info": "t:xo.info.orbit_image" },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:xo.labels.footnote",
      "default": "Based on traditional use. Shilajit is a food supplement, not a medicine, and is not intended to diagnose, treat, cure or prevent any disease."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:xo.names.benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:xo.labels.icon",
          "options": [
            { "value": "none", "label": "t:xo.options.icon_none" },
            { "value": "check-circle", "label": "t:xo.options.icon_check_circle" },
            { "value": "shield", "label": "t:xo.options.icon_shield" },
            { "value": "truck", "label": "t:xo.options.icon_truck" },
            { "value": "cash", "label": "t:xo.options.icon_cash" },
            { "value": "mountain", "label": "t:xo.options.icon_mountain" },
            { "value": "drop", "label": "t:xo.options.icon_drop" },
            { "value": "leaf", "label": "t:xo.options.icon_leaf" },
            { "value": "flask", "label": "t:xo.options.icon_flask" },
            { "value": "sun", "label": "t:xo.options.icon_sun" },
            { "value": "clock", "label": "t:xo.options.icon_clock" },
            { "value": "bolt", "label": "t:xo.options.icon_bolt" },
            { "value": "target", "label": "t:xo.options.icon_target" },
            { "value": "heart", "label": "t:xo.options.icon_heart" },
            { "value": "strength", "label": "t:xo.options.icon_strength" },
            { "value": "users", "label": "t:xo.options.icon_users" },
            { "value": "chat", "label": "t:xo.options.icon_chat" },
            { "value": "whatsapp", "label": "t:xo.options.icon_whatsapp" },
            { "value": "jar", "label": "t:xo.options.icon_jar" },
            { "value": "star", "label": "t:xo.options.icon_star" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "title", "label": "t:xo.labels.title", "default": "Everyday wellness" },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:xo.labels.text",
          "default": "<p>Traditionally used to support general well-being and vitality.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "strength",
            "title": "Strength and recovery",
            "text": "<p>Naturally contains 85+ trace minerals and fulvic acid. Traditionally used to support strength, recovery and endurance.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "sun",
            "title": "Active lifestyle",
            "text": "<p>Many people take shilajit as part of a training routine to support stamina and recovery.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "title": "Everyday wellness",
            "text": "<p>Contains natural antioxidants. Traditionally used to support general well-being and vitality.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "clock",
            "title": "Healthy ageing",
            "text": "<p>A long-standing part of Ayurvedic tradition for vitality in later years.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "bolt",
            "title": "Natural energy",
            "text": "<p>Fulvic acid is studied for its role in nutrient absorption. Many people take shilajit for steady daily energy.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "target",
            "title": "Focus and clarity",
            "text": "<p>Traditionally taken to support focus and mental clarity.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
