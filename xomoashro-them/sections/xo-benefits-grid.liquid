{%- liquid
  assign s = section.settings
-%}

{%- if section.blocks.size > 0 -%}
  <div class="xo-benefits xo-section xo-tone-{{ s.tone }}">
    <div class="xo-container">
      {%- render 'xo-section-heading', eyebrow: s.eyebrow, heading: s.heading, lead: s.lead -%}

      <ul
        class="xo-grid xo-benefits__list"
        role="list"
        style="--xo-cols-md: 2; --xo-cols-lg: 3;"
      >
        {%- for block in section.blocks -%}
          <li
            class="xo-card xo-feature"
            data-xo-reveal
            style="--xo-reveal-order: {{ forloop.index0 | modulo: 3 }};"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.icon != 'none' -%}
              {%- render 'xo-icon', name: block.settings.icon, class: 'xo-icon--badge' -%}
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="xo-feature__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="xo-feature__text xo-rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if s.footnote != blank -%}
        <p class="xo-footnote">{{ s.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-benefits__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.benefits",
  "tag": "section",
  "class": "xo-benefits-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 9,
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "bone"
    },
    { "type": "text", "id": "eyebrow", "label": "t:xo.labels.eyebrow", "default": "About our product" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "An ancient remedy for <em>everyday</em> well-being"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:xo.labels.lead",
      "default": "<p>Shilajit is a natural mineral resin with a long history in Ayurvedic tradition. Here is what people have taken it for.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:xo.labels.footnote",
      "default": "Based on traditional use. Shilajit is a food supplement, not a medicine, and is not intended to diagnose, treat, cure or prevent any disease."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:xo.names.benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:xo.labels.icon",
          "options": [
            { "value": "none", "label": "t:xo.options.icon_none" },
            { "value": "check-circle", "label": "t:xo.options.icon_check_circle" },
            { "value": "shield", "label": "t:xo.options.icon_shield" },
            { "value": "truck", "label": "t:xo.options.icon_truck" },
            { "value": "cash", "label": "t:xo.options.icon_cash" },
            { "value": "mountain", "label": "t:xo.options.icon_mountain" },
            { "value": "drop", "label": "t:xo.options.icon_drop" },
            { "value": "leaf", "label": "t:xo.options.icon_leaf" },
            { "value": "flask", "label": "t:xo.options.icon_flask" },
            { "value": "sun", "label": "t:xo.options.icon_sun" },
            { "value": "clock", "label": "t:xo.options.icon_clock" },
            { "value": "bolt", "label": "t:xo.options.icon_bolt" },
            { "value": "target", "label": "t:xo.options.icon_target" },
            { "value": "heart", "label": "t:xo.options.icon_heart" },
            { "value": "strength", "label": "t:xo.options.icon_strength" },
            { "value": "users", "label": "t:xo.options.icon_users" },
            { "value": "chat", "label": "t:xo.options.icon_chat" },
            { "value": "whatsapp", "label": "t:xo.options.icon_whatsapp" },
            { "value": "jar", "label": "t:xo.options.icon_jar" },
            { "value": "star", "label": "t:xo.options.icon_star" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "title", "label": "t:xo.labels.title", "default": "Everyday wellness" },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:xo.labels.text",
          "default": "<p>Traditionally used to support general well-being and vitality.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "strength",
            "title": "Strength and recovery",
            "text": "<p>Naturally contains 85+ trace minerals and fulvic acid. Traditionally used to support strength, recovery and endurance.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "sun",
            "title": "Active lifestyle",
            "text": "<p>Many people take shilajit as part of a training routine to support stamina and recovery.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "title": "Everyday wellness",
            "text": "<p>Contains natural antioxidants. Traditionally used to support general well-being and vitality.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "clock",
            "title": "Healthy ageing",
            "text": "<p>A long-standing part of Ayurvedic tradition for vitality in later years.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "bolt",
            "title": "Natural energy",
            "text": "<p>Fulvic acid is studied for its role in nutrient absorption. Many people take shilajit for steady daily energy.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "target",
            "title": "Focus and clarity",
            "text": "<p>Traditionally taken to support focus and mental clarity.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
