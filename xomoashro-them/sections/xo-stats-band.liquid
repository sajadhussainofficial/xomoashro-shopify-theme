{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- capture value -%}
      {%- render 'xo-fact-text', text: block.settings.value, requires: block.settings.requires -%}
    {%- endcapture -%}
    {%- if value != blank -%}
      <div
        class="xo-stats__item"
        data-xo-reveal
        style="--xo-reveal-order: {{ forloop.index0 }};"
        {{ block.shopify_attributes }}
      >
        <dt class="xo-stats__label">{{ block.settings.label | escape }}</dt>
        <dd class="xo-stat xo-stats__value">{{ value | escape }}</dd>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if items != blank -%}
  <div class="xo-stats xo-section xo-section--tight xo-tone-{{ section.settings.tone }}">
    <div class="xo-container">
      {%- if section.settings.heading != blank -%}
        <h2 class="xo-visually-hidden">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <dl class="xo-stats__list">
        {{ items }}
      </dl>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-stats__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--xo-space-6) var(--xo-space-5);
    margin: 0;
  }

  .xo-stats__item {
    display: grid;
    gap: var(--xo-space-2);
    align-content: start;
    padding-block-start: var(--xo-space-4);
    border-block-start: 1px solid var(--xo-line-strong);
  }

  .xo-stats__value {
    order: -1;
    margin: 0;
    color: var(--xo-highlight);
    font-size: clamp(2rem, 1.3rem + 3.2vw, 3.5rem);
  }

  .xo-stats__label {
    color: var(--xo-muted);
    font-size: var(--xo-text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 990px) {
    .xo-stats__list {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: var(--xo-space-7);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.stats",
  "tag": "section",
  "class": "xo-stats-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "ink"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.hidden_heading",
      "default": "Xomoashro in numbers"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:xo.names.stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:xo.labels.value",
          "info": "t:xo.info.fact_text",
          "default": "100%"
        },
        { "type": "text", "id": "label", "label": "t:xo.labels.label", "default": "Resin, no fillers" },
        {
          "type": "select",
          "id": "requires",
          "label": "t:xo.labels.requires",
          "info": "t:xo.info.requires",
          "options": [
            { "value": "none", "label": "t:xo.options.requires_none" },
            { "value": "free_shipping", "label": "t:xo.options.requires_free_shipping" },
            { "value": "guarantee", "label": "t:xo.options.requires_guarantee" },
            { "value": "delivery", "label": "t:xo.options.requires_delivery" },
            { "value": "whatsapp", "label": "t:xo.options.requires_whatsapp" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.stats",
      "blocks": [
        {
          "type": "stat",
          "settings": { "value": "16,000+", "label": "Feet, harvest altitude", "requires": "none" }
        },
        {
          "type": "stat",
          "settings": { "value": "85+", "label": "Trace minerals found in shilajit", "requires": "none" }
        },
        {
          "type": "stat",
          "settings": { "value": "100%", "label": "Resin, no fillers", "requires": "none" }
        },
        {
          "type": "stat",
          "settings": { "value": "[days] days", "label": "Money-back guarantee", "requires": "guarantee" }
        }
      ]
    }
  ]
}
{% endschema %}
