{%- liquid
  assign s = section.settings
-%}

{%- if section.blocks.size > 0 -%}
  <div class="xo-timeline xo-section xo-tone-{{ s.tone }}">
    <div class="xo-container xo-container--narrow">
      {%- if s.draft and request.design_mode -%}
        <p class="xo-editor-note xo-draft-note">{{ 'xo.editor.draft' | t }}</p>
      {%- endif -%}
      {%- render 'xo-section-heading', eyebrow: s.eyebrow, heading: s.heading, lead: s.lead -%}

      <ol
        class="xo-timeline__list"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li
            class="xo-timeline__item"
            data-xo-reveal
            {{ block.shopify_attributes }}
          >
            <p class="xo-eyebrow xo-timeline__period">{{ block.settings.period | escape }}</p>
            <div class="xo-feature">
              {%- if block.settings.title != blank -%}
                <h3 class="xo-feature__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="xo-feature__text xo-rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>

      {%- if s.footnote != blank -%}
        <p class="xo-footnote">{{ s.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-timeline__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xo-timeline__item {
    position: relative;
    display: grid;
    gap: var(--xo-space-2);
    padding-block-end: var(--xo-space-6);
    padding-inline-start: var(--xo-space-6);
    border-inline-start: 1px solid var(--xo-line-strong);
  }

  .xo-timeline__item:last-child {
    padding-block-end: 0;
  }

  .xo-timeline__item::before {
    content: '';
    position: absolute;
    inset-block-start: 0.125rem;
    inset-inline-start: -0.375rem;
    inline-size: 0.6875rem;
    block-size: 0.6875rem;
    border-radius: 50%;
    background: var(--xo-accent);
  }

  .xo-timeline__period {
    margin: 0;
  }

  @media (min-width: 750px) {
    .xo-timeline__item {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: var(--xo-space-5);
      align-items: start;
    }

    .xo-timeline__period {
      padding-block-start: 0.375rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.timeline",
  "tag": "section",
  "class": "xo-timeline-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "draft",
      "label": "t:xo.labels.draft",
      "info": "t:xo.info.draft",
      "default": true
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "bone"
    },
    { "type": "text", "id": "eyebrow", "label": "t:xo.labels.eyebrow", "default": "What to expect" },
    { "type": "inline_richtext", "id": "heading", "label": "t:xo.labels.heading", "default": "Give it time" },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:xo.labels.lead",
      "default": "<p>Shilajit is taken daily over weeks, not as a quick fix. Everyone is different, so treat this as a rough guide.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:xo.labels.footnote",
      "default": "Individual experiences vary. This is not medical advice."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:xo.names.timeline_step",
      "settings": [
        { "type": "text", "id": "period", "label": "t:xo.labels.period", "default": "Week 1" },
        { "type": "text", "id": "title", "label": "t:xo.labels.title", "default": "Getting started" },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:xo.labels.text",
          "default": "<p>Start with a small amount once a day.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.timeline",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "period": "Week 1",
            "title": "Getting started",
            "text": "<p>Start with a small amount once a day and let your body get used to the taste and routine.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "period": "Weeks 2–4",
            "title": "Building the habit",
            "text": "<p>With daily use, many people say this is when they start to notice a difference in how they feel through the day.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "period": "Weeks 5–8",
            "title": "Staying consistent",
            "text": "<p>Shilajit is traditionally taken as a longer course. Keep to the daily amount on the label.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
