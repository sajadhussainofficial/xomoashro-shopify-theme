{%- liquid
  assign s = section.settings
  assign ours_rows = ''
  assign others_rows = ''
-%}

{%- for block in section.blocks -%}
  {%- capture ours -%}
    {%- render 'xo-fact-text', text: block.settings.ours, requires: block.settings.requires -%}
  {%- endcapture -%}
  {%- if ours != blank and block.settings.label != blank -%}
    {%- capture ours_rows -%}
      {{- ours_rows -}}
      <div {{ block.shopify_attributes }}>
        <dt>{{ block.settings.label | escape }}</dt>
        <dd>{%- render 'xo-icon', name: 'check', size: 20 -%}<span>{{ ours | escape }}</span></dd>
      </div>
    {%- endcapture -%}
    {%- capture others_rows -%}
      {{- others_rows -}}
      <div>
        <dt>{{ block.settings.label | escape }}</dt>
        <dd>{%- render 'xo-icon', name: 'minus', size: 20 -%}<span>{{ block.settings.others | escape }}</span></dd>
      </div>
    {%- endcapture -%}
  {%- endif -%}
{%- endfor -%}

{%- if ours_rows != blank -%}
  <div class="xo-versus xo-section xo-tone-{{ s.tone }}">
    <div class="xo-container">
      {%- if s.draft and request.design_mode -%}
        <p class="xo-editor-note xo-draft-note">{{ 'xo.editor.draft' | t }}</p>
      {%- endif -%}
      {%- render 'xo-section-heading', heading: s.heading, lead: s.lead, align: 'center', rule: false -%}

      <div class="xo-versus__pair{% if s.image != blank %} xo-versus__pair--jar{% endif %}">
        <section
          class="xo-versus__card xo-versus__card--ours xo-tone-ink"
          aria-labelledby="XoOurs-{{ section.id }}"
        >
          {%- if s.image != blank -%}
            <div class="xo-versus__jar">
              {%- render 'xo-image', image: s.image, sizes: '160px', widths: '160, 320, 480', max_width: 480, decorative: true -%}
            </div>
          {%- endif -%}
          <h3
            class="xo-versus__name"
            id="XoOurs-{{ section.id }}"
          >
            {{- s.ours_heading | escape -}}
          </h3>
          <dl>{{ ours_rows }}</dl>
        </section>

        <span
          class="xo-versus__vs"
          aria-hidden="true"
        >
          {{- 'xo.compare.vs' | t -}}
        </span>

        <section
          class="xo-versus__card xo-versus__card--others"
          aria-labelledby="XoOthers-{{ section.id }}"
        >
          <h3
            class="xo-versus__name"
            id="XoOthers-{{ section.id }}"
          >
            {{- s.others_heading | escape -}}
          </h3>
          <dl>{{ others_rows }}</dl>
        </section>
      </div>

      {%- if s.footnote != blank -%}
        <p class="xo-footnote xo-versus__note">{{ s.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-versus__pair {
    display: grid;
    gap: var(--xo-space-4);
  }

  .xo-versus__pair--jar {
    margin-block-start: var(--xo-space-7);
  }

  .xo-versus__card {
    position: relative;
    display: grid;
    gap: var(--xo-space-5);
    align-content: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--xo-radius-card);
  }

  .xo-versus__card--others {
    border: 1.5px dashed var(--xo-line-strong);
    color: var(--xo-muted);
  }

  .xo-versus__name {
    margin: 0;
    color: var(--xo-fg);
    font-family: var(--xo-font-display);
    font-size: var(--xo-text-h4);
    font-weight: var(--xo-font-display-weight);
    letter-spacing: -0.012em;
  }

  .xo-versus__jar {
    position: absolute;
    inset-block-start: -3rem;
    inset-inline-end: 1.5rem;
    inline-size: 7.5rem;
    filter: drop-shadow(0 16px 14px rgb(0 0 0 / 0.4));
  }

  .xo-versus__card dl {
    display: grid;
    margin: 0;
  }

  .xo-versus__card dl > div {
    display: grid;
    gap: var(--xo-space-1);
    padding-block: 0.875rem;
    border-block-start: 1px solid var(--xo-line);
  }

  .xo-versus__card dt {
    color: var(--xo-muted);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .xo-versus__card dd {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    margin: 0;
    color: var(--xo-fg);
    font-weight: 600;
    line-height: 1.4;
  }

  .xo-versus__card--others dd {
    color: var(--xo-muted);
    font-weight: 500;
  }

  .xo-versus__card dd .xo-icon {
    margin-block-start: 0.0625rem;
  }

  .xo-versus__vs {
    z-index: 1;
    display: grid;
    place-items: center;
    justify-self: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    margin-block: calc(var(--xo-space-2) * -1);
    border: 1px solid var(--xo-line-strong);
    border-radius: 50%;
    background: var(--xo-bg);
    color: var(--xo-fg);
    font-weight: 700;
  }

  .xo-versus__note {
    text-align: center;
  }

  @media (min-width: 900px) {
    .xo-versus__pair {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 0;
      align-items: stretch;
      max-inline-size: 62rem;
      margin-inline: auto;
    }

    .xo-versus__pair--jar {
      margin-block-start: var(--xo-space-8);
    }

    .xo-versus__card--ours {
      padding-inline-end: 3.5rem;
    }

    .xo-versus__vs {
      align-self: center;
      margin: 0 -1.625rem;
    }

    .xo-versus__card--others {
      margin-block: var(--xo-space-5);
      padding-inline-start: 3.5rem;
      border-inline-start: 0;
      border-start-start-radius: 0;
      border-end-start-radius: 0;
    }

    .xo-versus__jar {
      inline-size: 9rem;
      inset-block-start: -3.5rem;
      inset-inline-end: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.comparison",
  "tag": "section",
  "class": "xo-compare-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 10,
  "settings": [
    {
      "type": "checkbox",
      "id": "draft",
      "label": "t:xo.labels.draft",
      "info": "t:xo.info.draft",
      "default": true
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "bone"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "Know what you are <em>buying</em>"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:xo.labels.lead",
      "default": "<p>Shilajit quality varies a lot. Here is what we commit to.</p>"
    },
    { "type": "text", "id": "ours_heading", "label": "t:xo.labels.ours_heading", "default": "Xomoashro" },
    {
      "type": "text",
      "id": "others_heading",
      "label": "t:xo.labels.others_heading",
      "default": "Typical market shilajit"
    },
    { "type": "image_picker", "id": "image", "label": "t:xo.labels.jar_image", "info": "t:xo.info.jar_image" },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:xo.labels.footnote",
      "default": "A general comparison. It does not refer to any specific brand."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:xo.names.row",
      "settings": [
        { "type": "text", "id": "label", "label": "t:xo.labels.label", "default": "Form" },
        {
          "type": "text",
          "id": "ours",
          "label": "t:xo.labels.ours",
          "info": "t:xo.info.fact_text",
          "default": "Pure resin"
        },
        { "type": "text", "id": "others", "label": "t:xo.labels.others", "default": "Varies" },
        {
          "type": "select",
          "id": "requires",
          "label": "t:xo.labels.requires",
          "info": "t:xo.info.requires",
          "options": [
            { "value": "none", "label": "t:xo.options.requires_none" },
            { "value": "free_shipping", "label": "t:xo.options.requires_free_shipping" },
            { "value": "guarantee", "label": "t:xo.options.requires_guarantee" },
            { "value": "delivery", "label": "t:xo.options.requires_delivery" },
            { "value": "whatsapp", "label": "t:xo.options.requires_whatsapp" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.comparison",
      "blocks": [
        {
          "type": "row",
          "settings": { "label": "Form", "ours": "Pure resin", "others": "Often powder or capsules", "requires": "none" }
        },
        {
          "type": "row",
          "settings": { "label": "Fillers or binders", "ours": "None", "others": "Not always stated", "requires": "none" }
        },
        {
          "type": "row",
          "settings": {
            "label": "Source",
            "ours": "Chitral and Gilgit-Baltistan, direct from collectors",
            "others": "Often not stated",
            "requires": "none"
          }
        },
        {
          "type": "row",
          "settings": { "label": "Payment", "ours": "Cash on delivery", "others": "Varies", "requires": "none" }
        },
        {
          "type": "row",
          "settings": { "label": "Guarantee", "ours": "[days]-day money-back", "others": "Varies", "requires": "guarantee" }
        },
        {
          "type": "row",
          "settings": {
            "label": "Support",
            "ours": "Help from our team on WhatsApp",
            "others": "Varies",
            "requires": "whatsapp"
          }
        }
      ]
    }
  ]
}
{% endschema %}
