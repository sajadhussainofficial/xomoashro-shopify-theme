{%- liquid
  assign s = section.settings
  assign report = s.report
  if report == blank
    assign newest = 0
    for entry in metaobjects.lab_report.values
      assign stamp = entry.test_date.value | date: '%s' | plus: 0
      if stamp >= newest
        assign newest = stamp
        assign report = entry
      endif
    endfor
  endif

  assign report_url = ''
  if report != blank
    assign report_file = report.report_file.value
    if report_file.media_type == 'image'
      assign report_url = report_file | image_url: width: 2400
    elsif report_file.url != blank
      assign report_url = report_file.url
    endif
  endif
-%}

{%- if report != blank -%}
  <div
    class="xo-cert xo-section xo-tone-{{ s.tone }}"
    {% if s.anchor != blank %}
      id="{{ s.anchor | handleize }}"
      data-xo-anchor
    {% endif %}
  >
    <div class="xo-container xo-cert__grid">
      <div class="xo-cert__copy">
        {%- render 'xo-section-heading', heading: s.heading, lead: s.lead, rule: false -%}
        <div class="xo-cert__actions">
          {%- if report_url != blank -%}
            {%- render 'xo-button', label: s.button_label, url: report_url, style: 'solid', attributes: 'target="_blank" rel="noopener"' -%}
          {%- endif -%}
          {%- if s.page_link != blank -%}
            {%- render 'xo-button', label: s.page_label, url: s.page_link, style: 'secondary' -%}
          {%- endif -%}
        </div>
      </div>

      <div class="xo-cert__stack">
        <div
          class="xo-cert__sheet xo-cert__sheet--back"
          aria-hidden="true"
        ></div>
        <div class="xo-cert__sheet">
          <div class="xo-cert__top">
            <div>
              {%- if s.sheet_title != blank -%}
                <p class="xo-cert__doc">{{ s.sheet_title | escape }}</p>
              {%- endif -%}
              {%- if report.lab.value != blank -%}
                <p class="xo-cert__lab">{{ report.lab.value | escape }}</p>
              {%- endif -%}
            </div>
            <svg
              class="xo-cert__seal"
              viewBox="0 0 80 80"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="40" cy="40" r="38" fill="none" stroke="currentColor" stroke-width="1"/>
              <circle cx="40" cy="40" r="30" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3"/>
              <path d="m28 41 8 8 16-18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <dl class="xo-cert__meta">
            {%- if s.product_name != blank -%}
              <div>
                <dt>{{ 'xo.lab.product' | t }}</dt>
                <dd>{{ s.product_name | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if report.batch.value != blank -%}
              <div>
                <dt>{{ 'xo.lab.batch' | t }}</dt>
                <dd>{{ report.batch.value | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if report.test_date.value != blank -%}
              <div>
                <dt>{{ 'xo.lab.tested_on' | t }}</dt>
                <dd>
                  <time datetime="{{ report.test_date.value | date: '%Y-%m-%d' }}">
                    {{- report.test_date.value | date: '%-d %B %Y' -}}
                  </time>
                </dd>
              </div>
            {%- endif -%}
          </dl>

          {%- if report.fulvic_percent.value != blank -%}
            <p class="xo-cert__fulvic">
              <span>{{ 'xo.lab.fulvic' | t }}</span>
              <strong>{{ report.fulvic_percent.value }}%</strong>
            </p>
          {%- endif -%}

          {%- liquid
            assign has_metals = false
            if report.lead_ppm.value != blank or report.arsenic_ppm.value != blank or report.mercury_ppm.value != blank or report.cadmium_ppm.value != blank
              assign has_metals = true
            endif
          -%}
          {%- if s.show_metals and has_metals -%}
            <table class="xo-cert__table">
              <caption>
                {{ 'xo.lab.metals_ppm' | t }}
              </caption>
              <tbody>
                {%- if report.lead_ppm.value != blank -%}
                  <tr>
                    <th scope="row">{{ 'xo.lab.lead' | t }}</th>
                    <td>{{ report.lead_ppm.value }}</td>
                  </tr>
                {%- endif -%}
                {%- if report.arsenic_ppm.value != blank -%}
                  <tr>
                    <th scope="row">{{ 'xo.lab.arsenic' | t }}</th>
                    <td>{{ report.arsenic_ppm.value }}</td>
                  </tr>
                {%- endif -%}
                {%- if report.mercury_ppm.value != blank -%}
                  <tr>
                    <th scope="row">{{ 'xo.lab.mercury' | t }}</th>
                    <td>{{ report.mercury_ppm.value }}</td>
                  </tr>
                {%- endif -%}
                {%- if report.cadmium_ppm.value != blank -%}
                  <tr>
                    <th scope="row">{{ 'xo.lab.cadmium' | t }}</th>
                    <td>{{ report.cadmium_ppm.value }}</td>
                  </tr>
                {%- endif -%}
              </tbody>
            </table>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="xo-section xo-section--tight xo-tone-{{ s.tone }}">
    <div class="xo-container">
      <p class="xo-editor-note">{{ 'xo.lab.empty' | t }}</p>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* The results shown as the paper certificate they come from. The sheet keeps its
     paper colours in every section tone. */
  .xo-cert__grid {
    display: grid;
    gap: var(--xo-space-7);
  }

  .xo-cert__copy {
    display: grid;
    gap: var(--xo-space-5);
    align-content: center;
    justify-items: start;
  }

  .xo-cert__copy .xo-heading {
    margin-block-end: 0;
  }

  .xo-cert__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--xo-space-3);
  }

  .xo-cert__stack {
    position: relative;
    justify-self: center;
    inline-size: min(100%, 27rem);
    margin-block: var(--xo-space-4);
  }

  .xo-cert__sheet {
    position: relative;
    display: grid;
    gap: var(--xo-space-5);
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-radius: 4px;
    background: #FFFEFB;
    color: #0B0B0D;
    box-shadow: 0 0 0 1px rgb(11 11 13 / 0.08), 0 30px 50px -28px rgb(11 11 13 / 0.45);
    transform: rotate(-1.4deg);
  }

  .xo-cert__sheet--back {
    position: absolute;
    inset: 0;
    background: #EFE8DC;
    transform: rotate(2.6deg);
  }

  .xo-cert__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--xo-space-4);
    padding-block-end: var(--xo-space-4);
    border-block-end: 2px solid #0B0B0D;
  }

  .xo-cert__doc {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .xo-cert__lab {
    margin: 0.125rem 0 0;
    color: #6B655C;
    font-size: var(--xo-text-sm);
  }

  .xo-cert__seal {
    flex: none;
    inline-size: 3.5rem;
    block-size: 3.5rem;
  }

  .xo-cert__meta {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    font-size: var(--xo-text-sm);
  }

  .xo-cert__meta div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--xo-space-3);
  }

  .xo-cert__meta dt {
    color: #6B655C;
  }

  .xo-cert__meta dd {
    margin: 0;
    font-weight: 600;
  }

  .xo-cert__fulvic {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--xo-space-4);
    margin: 0;
    padding-block: 0.875rem;
    border-block: 1px solid rgb(11 11 13 / 0.14);
  }

  .xo-cert__fulvic span {
    font-weight: 600;
  }

  .xo-cert__fulvic strong {
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .xo-cert__table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--xo-text-sm);
    font-variant-numeric: tabular-nums;
  }

  .xo-cert__table caption {
    padding-block-end: 0.375rem;
    color: #6B655C;
    text-align: start;
  }

  .xo-cert__table :is(th, td) {
    padding-block: 0.5rem;
    border-block-start: 1px solid rgb(11 11 13 / 0.1);
    font-weight: 500;
    text-align: start;
  }

  .xo-cert__table td {
    font-weight: 600;
    text-align: end;
  }

  @media (min-width: 900px) {
    .xo-cert__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--xo-space-8);
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.lab_proof",
  "tag": "section",
  "class": "xo-lab-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.lab_proof" },
    {
      "type": "metaobject",
      "id": "report",
      "label": "t:xo.labels.lab_report",
      "info": "t:xo.info.lab_report",
      "metaobject_type": "lab_report"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "bone"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "See the report <em>for yourself</em>"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:xo.labels.lead",
      "default": "<p>These are the lab results for the batch on sale now. Open the full report to see every figure.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:xo.labels.button_label",
      "default": "View the lab report"
    },
    {
      "type": "text",
      "id": "page_label",
      "label": "t:xo.labels.secondary_button_label",
      "default": "All lab reports"
    },
    { "type": "url", "id": "page_link", "label": "t:xo.labels.secondary_button_link" },
    {
      "type": "text",
      "id": "sheet_title",
      "label": "t:xo.labels.sheet_title",
      "default": "Certificate of analysis"
    },
    {
      "type": "text",
      "id": "product_name",
      "label": "t:xo.labels.product_name",
      "default": "Pure Himalayan Aftabi Shilajit"
    },
    { "type": "checkbox", "id": "show_metals", "label": "t:xo.labels.show_metals", "default": true },
    { "type": "text", "id": "anchor", "label": "t:xo.labels.anchor", "info": "t:xo.info.anchor" }
  ],
  "presets": [
    {
      "name": "t:xo.names.lab_proof",
      "settings": { "page_link": "/pages/lab-reports" }
    }
  ]
}
{% endschema %}
