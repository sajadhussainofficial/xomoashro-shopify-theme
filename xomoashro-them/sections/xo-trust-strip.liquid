{%- liquid
  assign s = section.settings
-%}

{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- capture line -%}
      {%- render 'xo-fact-text', text: block.settings.text, requires: block.settings.requires -%}
    {%- endcapture -%}
    {%- if line != blank -%}
      <li
        class="xo-ribbon__item"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.icon != 'none' -%}
          {%- render 'xo-icon', name: block.settings.icon, size: 20 -%}
        {%- endif -%}
        <span>{{ line | escape }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if items != blank -%}
  {%- capture copy -%}
    {%- for block in section.blocks -%}
      {%- capture line -%}
        {%- render 'xo-fact-text', text: block.settings.text, requires: block.settings.requires -%}
      {%- endcapture -%}
      {%- if line != blank -%}
        <li class="xo-ribbon__item">
          {%- if block.settings.icon != 'none' -%}
            {%- render 'xo-icon', name: block.settings.icon, size: 20 -%}
          {%- endif -%}
          <span>{{ line | escape }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  <div
    class="xo-ribbon xo-tone-{{ s.tone }}{% unless s.move %} xo-ribbon--still{% endunless %}"
    style="--xo-ribbon-time: {{ s.speed }}s;"
    role="region"
    aria-label="{{ 'xo.trust.label' | t }}"
  >
    <div class="xo-ribbon__track">
      <ul
        class="xo-ribbon__list"
        role="list"
      >
        {{ items }}
      </ul>
      {%- if s.move -%}
        <div
          class="xo-ribbon__copies"
          aria-hidden="true"
        >
          <ul class="xo-ribbon__list">{{ copy }}</ul>
          <ul class="xo-ribbon__list">{{ copy }}</ul>
          <ul class="xo-ribbon__list">{{ copy }}</ul>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* A slow ribbon of short points. Four copies of the list move by half the track,
     so the loop has no visible seam on screens up to twice the list's width. */
  .xo-ribbon {
    overflow: hidden;
    border-block: 1px solid var(--xo-line);
  }

  .xo-ribbon__track {
    display: flex;
    inline-size: max-content;
    animation: xo-ribbon-move var(--xo-ribbon-time, 45s) linear infinite;
  }

  .xo-ribbon:hover .xo-ribbon__track {
    animation-play-state: paused;
  }

  .xo-ribbon__list,
  .xo-ribbon__copies {
    display: flex;
    flex: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xo-ribbon__item {
    display: flex;
    align-items: center;
    gap: var(--xo-space-3);
    padding-block: 1.25rem;
    padding-inline-start: 2.5rem;
    color: var(--xo-fg);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }

  .xo-ribbon__item::after {
    content: '';
    inline-size: 0.3125rem;
    block-size: 0.3125rem;
    margin-inline-start: 2.5rem;
    border-radius: 50%;
    background: var(--xo-heading-soft);
  }

  @keyframes xo-ribbon-move {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes xo-ribbon-move-rtl {
    to {
      transform: translateX(50%);
    }
  }

  [dir='rtl'] .xo-ribbon__track {
    animation-name: xo-ribbon-move-rtl;
  }

  .xo-ribbon--still .xo-ribbon__track {
    inline-size: auto;
    animation: none;
  }

  .xo-ribbon--still .xo-ribbon__list {
    flex: 1 1 auto;
    flex-wrap: wrap;
    justify-content: center;
  }

  .xo-ribbon--still .xo-ribbon__item {
    padding-inline: 1.25rem;
  }

  .xo-ribbon--still .xo-ribbon__item::after {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-ribbon__track {
      inline-size: auto;
      animation: none;
    }

    .xo-ribbon__list {
      flex: 1 1 auto;
      flex-wrap: wrap;
      justify-content: center;
    }

    .xo-ribbon__copies {
      display: none;
    }

    .xo-ribbon__item {
      padding-inline: 1.25rem;
    }

    .xo-ribbon__item::after {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.trust_strip",
  "tag": "section",
  "class": "xo-trust-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "ink"
    },
    {
      "type": "checkbox",
      "id": "move",
      "label": "t:xo.labels.move",
      "info": "t:xo.info.trust_move",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:xo.labels.speed_pass",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 45,
      "visible_if": "{{ section.settings.move }}"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:xo.names.trust_item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:xo.labels.text",
          "info": "t:xo.info.fact_text",
          "default": "Cash on delivery"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:xo.labels.icon",
          "options": [
            { "value": "none", "label": "t:xo.options.icon_none" },
            { "value": "check-circle", "label": "t:xo.options.icon_check_circle" },
            { "value": "shield", "label": "t:xo.options.icon_shield" },
            { "value": "truck", "label": "t:xo.options.icon_truck" },
            { "value": "cash", "label": "t:xo.options.icon_cash" },
            { "value": "mountain", "label": "t:xo.options.icon_mountain" },
            { "value": "drop", "label": "t:xo.options.icon_drop" },
            { "value": "leaf", "label": "t:xo.options.icon_leaf" },
            { "value": "flask", "label": "t:xo.options.icon_flask" },
            { "value": "sun", "label": "t:xo.options.icon_sun" },
            { "value": "clock", "label": "t:xo.options.icon_clock" },
            { "value": "bolt", "label": "t:xo.options.icon_bolt" },
            { "value": "target", "label": "t:xo.options.icon_target" },
            { "value": "heart", "label": "t:xo.options.icon_heart" },
            { "value": "strength", "label": "t:xo.options.icon_strength" },
            { "value": "users", "label": "t:xo.options.icon_users" },
            { "value": "chat", "label": "t:xo.options.icon_chat" },
            { "value": "whatsapp", "label": "t:xo.options.icon_whatsapp" },
            { "value": "jar", "label": "t:xo.options.icon_jar" },
            { "value": "star", "label": "t:xo.options.icon_star" }
          ],
          "default": "check-circle"
        },
        {
          "type": "select",
          "id": "requires",
          "label": "t:xo.labels.requires",
          "info": "t:xo.info.requires",
          "options": [
            { "value": "none", "label": "t:xo.options.requires_none" },
            { "value": "free_shipping", "label": "t:xo.options.requires_free_shipping" },
            { "value": "guarantee", "label": "t:xo.options.requires_guarantee" },
            { "value": "delivery", "label": "t:xo.options.requires_delivery" },
            { "value": "whatsapp", "label": "t:xo.options.requires_whatsapp" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.trust_strip",
      "blocks": [
        {
          "type": "item",
          "settings": { "text": "Cash on delivery", "icon": "cash", "requires": "none" }
        },
        {
          "type": "item",
          "settings": { "text": "Delivery across Pakistan", "icon": "truck", "requires": "none" }
        },
        {
          "type": "item",
          "settings": { "text": "Direct from local collectors", "icon": "mountain", "requires": "none" }
        },
        {
          "type": "item",
          "settings": { "text": "Help on WhatsApp", "icon": "whatsapp", "requires": "whatsapp" }
        },
        {
          "type": "item",
          "settings": { "text": "100% resin, no fillers", "icon": "drop", "requires": "none" }
        },
        {
          "type": "item",
          "settings": { "text": "[days]-day money-back guarantee", "icon": "shield", "requires": "guarantee" }
        }
      ]
    }
  ]
}
{% endschema %}
