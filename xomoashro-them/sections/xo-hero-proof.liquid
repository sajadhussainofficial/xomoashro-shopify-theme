{%- liquid
  assign s = section.settings
  assign has_image = false
  if s.image != blank
    assign has_image = true
  endif
  assign preload_image = true
  if s.image_mobile != blank
    assign preload_image = false
  endif
-%}

{%- capture stats -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'stat' -%}
      {%- continue -%}
    {%- endif -%}
    {%- capture value -%}
      {%- render 'xo-fact-text', text: block.settings.value, requires: block.settings.requires -%}
    {%- endcapture -%}
    {%- if value != blank -%}
      <div
        class="xo-hero__stat"
        {{ block.shopify_attributes }}
      >
        <dt>{{ block.settings.label | escape }}</dt>
        <dd>{{ value | escape }}</dd>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div class="xo-hero xo-tone-ink{% if has_image %} xo-hero--media{% endif %}">
  {%- if has_image -%}
    <picture class="xo-hero__picture">
      {%- if s.image_mobile != blank -%}
        <source
          media="(max-width: 989px)"
          srcset="
            {{ s.image_mobile | image_url: width: 480 }} 480w,
            {{ s.image_mobile | image_url: width: 750 }} 750w,
            {{ s.image_mobile | image_url: width: 1100 }} 1100w
          "
          sizes="100vw"
          width="{{ s.image_mobile.width }}"
          height="{{ s.image_mobile.height }}"
        >
      {%- endif -%}
      {%- render 'xo-image',
        image: s.image,
        sizes: '100vw',
        widths: '750, 990, 1280, 1600, 1920, 2400',
        max_width: 2400,
        priority: true,
        preload: preload_image
      -%}
    </picture>
  {%- endif -%}

  <div class="xo-container xo-hero__content">
    {%- if s.eyebrow != blank -%}
      <p class="xo-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h1 class="xo-h1 xo-hero__heading">{{ s.heading }}</h1>
    {%- endif -%}
    {%- if s.text != blank -%}
      <div class="xo-lead xo-muted xo-rte xo-hero__text">{{ s.text }}</div>
    {%- endif -%}

    {%- capture actions -%}
      {%- if s.button_link != blank -%}
        {%- render 'xo-button', label: s.button_label, url: s.button_link, icon: 'arrow-right' -%}
      {%- endif -%}
      {%- if s.secondary_button_link != blank -%}
        {%- render 'xo-button', label: s.secondary_button_label, url: s.secondary_button_link, style: 'quiet' -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if actions != blank -%}
      <div class="xo-hero__actions">{{ actions }}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="xo-hero__rating">{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if stats != blank -%}
    <div class="xo-container">
      <dl class="xo-hero__stats">
        {{ stats }}
      </dl>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Dark, full-width opening section. On computers the picture fills the section and
     fades to the dark colour behind the text; on phones and tablets it sits above
     the text. */

  .xo-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .xo-hero__picture {
    position: relative;
    display: block;
  }

  .xo-hero__picture .xo-img {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: 70% 60%;
  }

  .xo-hero__picture::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--xo-ink) 30%, transparent) 0%,
      transparent 26%,
      transparent 52%,
      var(--xo-ink) 100%
    );
    pointer-events: none;
  }

  .xo-hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--xo-space-5);
    justify-items: start;
    padding-block: var(--xo-space-7) var(--xo-space-7);
  }

  .xo-hero--media .xo-hero__content {
    margin-block-start: calc(var(--xo-space-6) * -1);
    padding-block-start: 0;
  }

  .xo-hero__heading {
    max-inline-size: 12ch;
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.875rem);
    letter-spacing: -0.042em;
    line-height: 1;
  }

  .xo-hero__text {
    max-inline-size: 29rem;
  }

  .xo-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--xo-space-3) var(--xo-space-5);
  }

  .xo-hero__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-block-start: 1px solid var(--xo-line-strong);
  }

  .xo-hero__stat {
    display: grid;
    gap: 0.125rem;
    align-content: start;
    padding-block: var(--xo-space-4);
    border-block-end: 1px solid var(--xo-line);
  }

  .xo-hero__stat:nth-child(odd) {
    padding-inline-end: var(--xo-space-4);
  }

  .xo-hero__stat dd {
    order: -1;
    margin: 0;
    color: var(--xo-fg);
    font-family: var(--xo-font-display);
    font-size: 1.5rem;
    font-weight: var(--xo-font-display-weight);
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .xo-hero__stat dt {
    color: var(--xo-muted);
    font-size: var(--xo-text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  @media (max-width: 479px) {
    .xo-hero__actions .xo-btn:not(.xo-btn--quiet) {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 750px) and (max-width: 989px) {
    .xo-hero__picture .xo-img {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 990px) {
    .xo-hero {
      display: grid;
      grid-template-rows: 1fr auto;
    }

    .xo-hero--media {
      min-block-size: clamp(40rem, 50vw, 54rem);
    }

    .xo-hero__picture {
      position: absolute;
      inset: 0;
      z-index: -1;
    }

    .xo-hero__picture .xo-img {
      block-size: 100%;
      aspect-ratio: auto;
      object-position: 50% 62%;
    }

    .xo-hero__picture::after {
      background:
        linear-gradient(
          to top,
          var(--xo-ink) 0%,
          color-mix(in srgb, var(--xo-ink) 72%, transparent) 14%,
          transparent 38%
        ),
        linear-gradient(
          to right,
          var(--xo-ink) 0%,
          color-mix(in srgb, var(--xo-ink) 92%, transparent) 26%,
          color-mix(in srgb, var(--xo-ink) 55%, transparent) 46%,
          transparent 66%
        );
    }

    [dir='rtl'] .xo-hero__picture {
      transform: scaleX(-1);
    }

    .xo-hero__content,
    .xo-hero--media .xo-hero__content {
      align-content: center;
      margin-block-start: 0;
      padding-block: var(--xo-space-7);
    }

    .xo-hero__stats {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      grid-template-columns: none;
    }

    .xo-hero__stat,
    .xo-hero__stat:nth-child(odd) {
      padding: var(--xo-space-5) 0 var(--xo-space-6);
      border-block-end: 0;
    }

    .xo-hero__stat + .xo-hero__stat {
      padding-inline-start: var(--xo-space-6);
      border-inline-start: 1px solid var(--xo-line);
    }

    .xo-hero__stat dd {
      font-size: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.hero",
  "tag": "section",
  "class": "xo-hero-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.hero" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:xo.labels.eyebrow",
      "default": "Himalayan Aftabi Shilajit · Pakistan"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "default": "Elevate your life with pure Himalayan Aftabi Shilajit"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:xo.labels.text",
      "default": "<p>Pure Himalayan shilajit resin, traditionally taken for daily energy, focus and vitality. Sourced above 16,000 ft and delivered across Pakistan.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:xo.labels.button_label", "default": "Shop Shilajit" },
    { "type": "url", "id": "button_link", "label": "t:xo.labels.button_link", "default": "/collections/all" },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:xo.labels.secondary_button_label",
      "default": "How to use"
    },
    { "type": "url", "id": "secondary_button_link", "label": "t:xo.labels.secondary_button_link" },
    { "type": "header", "content": "t:xo.labels.picture_header" },
    { "type": "image_picker", "id": "image", "label": "t:xo.labels.image", "info": "t:xo.info.hero_image" },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:xo.labels.image_mobile",
      "info": "t:xo.info.hero_image_mobile"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:xo.names.stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:xo.labels.value",
          "info": "t:xo.info.fact_text",
          "default": "100%"
        },
        { "type": "text", "id": "label", "label": "t:xo.labels.label", "default": "Resin, no fillers" },
        {
          "type": "select",
          "id": "requires",
          "label": "t:xo.labels.requires",
          "info": "t:xo.info.requires",
          "options": [
            { "value": "none", "label": "t:xo.options.requires_none" },
            { "value": "free_shipping", "label": "t:xo.options.requires_free_shipping" },
            { "value": "guarantee", "label": "t:xo.options.requires_guarantee" },
            { "value": "delivery", "label": "t:xo.options.requires_delivery" },
            { "value": "whatsapp", "label": "t:xo.options.requires_whatsapp" }
          ],
          "default": "none"
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "t:xo.names.hero",
      "settings": {
        "secondary_button_link": "/pages/how-to-use"
      },
      "blocks": [
        { "type": "stat", "settings": { "value": "16,000+", "label": "Feet, harvest altitude", "requires": "none" } },
        { "type": "stat", "settings": { "value": "85+", "label": "Trace minerals in shilajit", "requires": "none" } },
        { "type": "stat", "settings": { "value": "100%", "label": "Resin, no fillers", "requires": "none" } },
        { "type": "stat", "settings": { "value": "[days] days", "label": "Money-back guarantee", "requires": "guarantee" } }
      ]
    }
  ]
}
{% endschema %}
