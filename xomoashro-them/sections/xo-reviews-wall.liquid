{%- liquid
  assign s = section.settings
  assign reviews = section.blocks | where: 'type', 'review'
  assign half = reviews.size | plus: 1 | divided_by: 2
-%}

{%- if section.blocks.size > 0 -%}
  <div
    class="xo-wall xo-section xo-tone-{{ s.tone }}"
    {% if s.anchor != blank %}
      id="{{ s.anchor | handleize }}"
      data-xo-anchor
    {% endif %}
  >
    <div class="xo-container">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="xo-wall__app">{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}

      <div class="xo-wall__grid">
        <div class="xo-wall__col">
          {%- render 'xo-section-heading', heading: s.heading, lead: s.lead, rule: false -%}
          {%- if s.image != blank -%}
            <div class="xo-media xo-wall__pic">
              {%- render 'xo-image', image: s.image, sizes: '(min-width: 990px) 33vw, 100vw' -%}
            </div>
          {%- endif -%}
        </div>

        <div class="xo-wall__col">
          {%- for block in reviews limit: half -%}
            {%- render 'xo-review-card', block: block -%}
          {%- endfor -%}
        </div>

        <div class="xo-wall__col xo-wall__col--drop">
          {%- for block in reviews offset: half -%}
            {%- render 'xo-review-card', block: block -%}
          {%- endfor -%}

          {%- if s.buy_heading != blank or s.button_link != blank -%}
            <div class="xo-wall__buy">
              {%- if s.buy_heading != blank -%}
                <p class="xo-feature__title">{{ s.buy_heading | escape }}</p>
              {%- endif -%}
              {%- if s.button_link != blank -%}
                {%- render 'xo-button', label: s.button_label, url: s.button_link -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-wall__app {
    margin-block-end: var(--xo-space-7);
  }

  .xo-wall__grid {
    display: grid;
    gap: var(--xo-space-5);
  }

  .xo-wall__col {
    display: grid;
    gap: var(--xo-space-5);
    align-content: start;
  }

  .xo-wall__col .xo-heading {
    margin-block-end: var(--xo-space-2);
  }

  .xo-wall__pic {
    aspect-ratio: 4 / 3;
  }

  .xo-wall__pic .xo-img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .xo-wall__card {
    display: grid;
    gap: var(--xo-space-5);
    margin: 0;
    padding: 1.75rem;
    border: 1px solid var(--xo-line);
    border-radius: var(--xo-radius-card);
    background: var(--xo-surface);
  }

  .xo-wall__card blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--xo-fg);
    font-size: 1.0625rem;
    font-style: normal;
    line-height: 1.6;
  }

  .xo-wall__card figcaption {
    display: flex;
    align-items: center;
    gap: var(--xo-space-3);
  }

  .xo-wall__avatar {
    display: grid;
    flex: none;
    place-items: center;
    overflow: hidden;
    inline-size: 3rem;
    block-size: 3rem;
    border: 1px solid var(--xo-line-strong);
    border-radius: 50%;
    color: var(--xo-fg);
    font-weight: 600;
  }

  .xo-wall__avatar .xo-img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .xo-wall__who {
    display: grid;
    color: var(--xo-muted);
    font-size: var(--xo-text-sm);
    line-height: 1.35;
  }

  .xo-wall__who strong {
    color: var(--xo-fg);
    font-size: var(--xo-text-base);
    font-weight: 600;
  }

  .xo-wall__buy {
    display: grid;
    gap: var(--xo-space-4);
    justify-items: start;
    padding: 1.75rem;
    border: 1px dashed var(--xo-line-strong);
    border-radius: var(--xo-radius-card);
  }

  @media (min-width: 990px) {
    .xo-wall__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .xo-wall__pic {
      aspect-ratio: 4 / 5;
    }

    .xo-wall__col--drop {
      margin-block-start: 5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.reviews",
  "tag": "section",
  "class": "xo-reviews-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.reviews" },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "ink"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "What our customers <em>say</em>"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:xo.labels.lead",
      "default": "<p>Trusted by customers across Pakistan.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "t:xo.labels.image" },
    { "type": "header", "content": "t:xo.labels.buy_header" },
    {
      "type": "text",
      "id": "buy_heading",
      "label": "t:xo.labels.buy_heading",
      "default": "Try it for yourself"
    },
    { "type": "text", "id": "button_label", "label": "t:xo.labels.button_label", "default": "Shop Shilajit" },
    { "type": "url", "id": "button_link", "label": "t:xo.labels.button_link", "default": "/collections/all" },
    { "type": "text", "id": "anchor", "label": "t:xo.labels.anchor", "info": "t:xo.info.anchor" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:xo.names.review",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:xo.labels.quote",
          "default": "<p>Share what a customer told you, in their own words.</p>"
        },
        { "type": "text", "id": "name", "label": "t:xo.labels.name", "default": "Customer name" },
        { "type": "text", "id": "role", "label": "t:xo.labels.role" },
        { "type": "image_picker", "id": "image", "label": "t:xo.labels.photo", "info": "t:xo.info.photo" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "t:xo.names.reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "<p>I'm delighted with the high-quality shilajit from Xomoashro. Their product has noticeably improved my well-being, and the prompt delivery service adds to the overall positive experience. Xomoashro is my go-to for top-tier shilajit and reliable service.</p>",
            "name": "Abdullah",
            "role": "Cricketer"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "<p>Xomoashro's shilajit is top-notch! The quality is impressive, and their delivery is quick and reliable. I highly recommend their product for anyone seeking premium shilajit.</p>",
            "name": "Asad",
            "role": "Customer"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "<p>Xomoashro's shilajit is a game-changer! The quality is outstanding, and their fast delivery makes it a hassle-free experience. Highly recommend for anyone looking for a reliable and effective supplement.</p>",
            "name": "Taimoor Khan",
            "role": "Professional international boxer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
