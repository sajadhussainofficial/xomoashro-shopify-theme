{%- liquid
  assign s = section.settings
  assign reviews = section.blocks | where: 'type', 'review'
-%}

{%- if section.blocks.size > 0 -%}
  <div
    class="xo-reviews xo-section xo-tone-{{ s.tone }}"
    {% if s.anchor != blank %}
      id="{{ s.anchor | handleize }}"
      data-xo-anchor
    {% endif %}
  >
    <div class="xo-container">
      {%- render 'xo-section-heading', eyebrow: s.eyebrow, heading: s.heading, lead: s.lead -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="xo-reviews__app">{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}

      {%- if reviews.size > 0 -%}
        <ul
          class="xo-grid xo-reviews__list"
          role="list"
          style="--xo-cols-md: 2; --xo-cols-lg: 3;"
        >
          {%- for block in reviews -%}
            {%- if block.settings.quote == blank -%}
              {%- continue -%}
            {%- endif -%}
            <li
              class="xo-reviews__item"
              data-xo-reveal
              style="--xo-reveal-order: {{ forloop.index0 | modulo: 3 }};"
              {{ block.shopify_attributes }}
            >
              <figure class="xo-card xo-review">
                {%- render 'xo-icon', name: 'quote', size: 28, class: 'xo-review__mark' -%}
                <blockquote class="xo-review__quote xo-rte">{{ block.settings.quote }}</blockquote>
                {%- if block.settings.name != blank -%}
                  <figcaption class="xo-review__person">
                    {%- if block.settings.image != blank -%}
                      <span class="xo-review__avatar">
                        {%- render 'xo-image', image: block.settings.image, sizes: '48px', widths: '48, 96, 144', max_width: 144, decorative: true -%}
                      </span>
                    {%- else -%}
                      <span
                        class="xo-review__avatar"
                        aria-hidden="true"
                      >
                        {{- block.settings.name | strip | slice: 0 | upcase -}}
                      </span>
                    {%- endif -%}
                    <span>
                      <span class="xo-review__name">{{ block.settings.name | escape }}</span>
                      {%- if block.settings.role != blank -%}
                        <span class="xo-review__role">{{ block.settings.role | escape }}</span>
                      {%- endif -%}
                    </span>
                  </figcaption>
                {%- endif -%}
              </figure>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-reviews__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xo-reviews__app {
    margin-block-end: var(--xo-space-6);
  }

  .xo-reviews__item {
    display: grid;
  }

  .xo-review {
    grid-template-rows: auto 1fr auto;
    gap: var(--xo-space-4);
    margin: 0;
  }

  .xo-review__mark {
    color: var(--xo-highlight);
  }

  .xo-review__quote {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--xo-fg);
    font-size: var(--xo-text-base);
    font-style: normal;
    line-height: 1.6;
  }

  .xo-review__person {
    display: flex;
    align-items: center;
    gap: var(--xo-space-3);
    padding-block-start: var(--xo-space-4);
    border-block-start: 1px solid var(--xo-line);
  }

  .xo-review__avatar {
    display: grid;
    flex: none;
    place-items: center;
    overflow: hidden;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 50%;
    background: var(--xo-bg);
    border: 1px solid var(--xo-line-strong);
    color: var(--xo-highlight);
    font-family: var(--xo-font-display);
    font-weight: 600;
  }

  .xo-review__avatar img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .xo-review__name,
  .xo-review__role {
    display: block;
    line-height: 1.35;
  }

  .xo-review__name {
    color: var(--xo-fg);
    font-weight: 600;
  }

  .xo-review__role {
    color: var(--xo-muted);
    font-size: var(--xo-text-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.reviews",
  "tag": "section",
  "class": "xo-reviews-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.reviews" },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "surface"
    },
    { "type": "text", "id": "eyebrow", "label": "t:xo.labels.eyebrow", "default": "Reviews" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "What our customers <em>say</em>"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:xo.labels.lead",
      "default": "<p>Trusted by customers across Pakistan.</p>"
    },
    { "type": "text", "id": "anchor", "label": "t:xo.labels.anchor", "info": "t:xo.info.anchor" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:xo.names.review",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:xo.labels.quote",
          "default": "<p>Share what a customer told you, in their own words.</p>"
        },
        { "type": "text", "id": "name", "label": "t:xo.labels.name", "default": "Customer name" },
        { "type": "text", "id": "role", "label": "t:xo.labels.role" },
        { "type": "image_picker", "id": "image", "label": "t:xo.labels.photo", "info": "t:xo.info.photo" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "t:xo.names.reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "<p>I'm delighted with the high-quality shilajit from Xomoashro. Their product has noticeably improved my well-being, and the prompt delivery service adds to the overall positive experience. Xomoashro is my go-to for top-tier shilajit and reliable service.</p>",
            "name": "Abdullah",
            "role": "Cricketer"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "<p>Xomoashro's shilajit is top-notch! The quality is impressive, and their delivery is quick and reliable. I highly recommend their product for anyone seeking premium shilajit.</p>",
            "name": "Asad",
            "role": "Customer"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "<p>Xomoashro's shilajit is a game-changer! The quality is outstanding, and their fast delivery makes it a hassle-free experience. Highly recommend for anyone looking for a reliable and effective supplement.</p>",
            "name": "Taimoor Khan",
            "role": "Professional international boxer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
