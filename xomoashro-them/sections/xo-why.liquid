{%- liquid
  assign s = section.settings
-%}

{%- if section.blocks.size > 0 -%}
  <div class="xo-reasons xo-section xo-tone-{{ s.tone }}">
    <div class="xo-container xo-reasons__grid">
      <div class="xo-reasons__intro">
        {%- render 'xo-section-heading', heading: s.heading, lead: s.lead, rule: false -%}
        {%- if s.button_link != blank -%}
          {%- render 'xo-button', label: s.button_label, url: s.button_link -%}
        {%- endif -%}
      </div>

      <dl class="xo-reasons__list">
        {%- for block in section.blocks -%}
          {%- if block.settings.title != blank -%}
            <div
              class="xo-reasons__row"
              {{ block.shopify_attributes }}
            >
              <dt>{{ block.settings.title | escape }}</dt>
              <dd class="xo-rte">{{ block.settings.text }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-reasons__grid {
    display: grid;
    gap: var(--xo-space-7);
  }

  .xo-reasons__intro {
    display: grid;
    gap: var(--xo-space-5);
    align-content: start;
    justify-items: start;
  }

  .xo-reasons__intro .xo-heading {
    margin-block-end: 0;
  }

  .xo-reasons__list {
    margin: 0;
    border-block-end: 1px solid var(--xo-line-strong);
  }

  .xo-reasons__row {
    display: grid;
    gap: var(--xo-space-2);
    padding-block: 1.375rem;
    border-block-start: 1px solid var(--xo-line-strong);
  }

  .xo-reasons__row dt {
    color: var(--xo-fg);
    font-family: var(--xo-font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: var(--xo-font-display-weight);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .xo-reasons__row dd {
    margin: 0;
    color: var(--xo-muted);
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .xo-reasons__row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--xo-space-6);
      align-items: baseline;
    }
  }

  @media (min-width: 990px) {
    .xo-reasons__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 5rem;
    }

    .xo-reasons__intro {
      position: sticky;
      inset-block-start: calc(var(--header-height, 4.5rem) + var(--xo-space-6));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.why",
  "tag": "section",
  "class": "xo-why-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 10,
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "ink"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "Why choose <em>Xomoashro</em>"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:xo.labels.lead",
      "default": "<p>Xomoashro brings pure, authentic Aftabi Shilajit from the Himalayas to homes across Pakistan. Easy to use, fairly priced, and sourced with care.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:xo.labels.button_label", "default": "Shop Shilajit" },
    { "type": "url", "id": "button_link", "label": "t:xo.labels.button_link", "default": "/collections/all" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "t:xo.names.reason",
      "settings": [
        { "type": "text", "id": "title", "label": "t:xo.labels.title", "default": "Authentic" },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:xo.labels.text",
          "default": "<p>Directly sourced from trusted Himalayan collectors.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.why",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "title": "Authentic",
            "text": "<p>Directly sourced from trusted Himalayan collectors and carefully processed for natural purity.</p>"
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Genuine Himalayan shilajit",
            "text": "<p>Collected from the pristine regions of Chitral and Gilgit-Baltistan.</p>"
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "100% pure resin",
            "text": "<p>No fillers, additives or binders. Just concentrated shilajit resin in its purest form.</p>"
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Nationwide delivery",
            "text": "<p>Reliable shipping across Pakistan with tracking support.</p>"
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Guided support",
            "text": "<p>Clear instructions, and help from our team on WhatsApp, so you get the most from your shilajit.</p>"
          }
        },
        {
          "type": "reason",
          "settings": {
            "title": "Customer promise",
            "text": "<p>We are committed to resolving concerns quickly. Your trust matters most.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
