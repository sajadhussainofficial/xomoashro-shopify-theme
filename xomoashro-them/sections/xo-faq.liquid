{%- liquid
  assign s = section.settings
  assign topics = section.blocks | where: 'type', 'topic'
  assign use_tabs = false
  if topics.size > 1
    assign use_tabs = true
  endif

  capture whatsapp_url
    render 'xo-shop-facts', fact: 'whatsapp_url', message: s.whatsapp_message
  endcapture
  capture support_email
    render 'xo-shop-facts', fact: 'support_email'
  endcapture
-%}

{%- comment -%} Questions placed before the first topic are shown with that topic. {%- endcomment -%}
{%- capture leading -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'topic' -%}
      {%- break -%}
    {%- endif -%}
    {%- if block.type == 'question' -%}
      {%- render 'xo-faq-entry', block: block -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture panels -%}
  {%- if topics.size == 0 -%}
    <div class="xo-topics__panel">{{ leading }}</div>
  {%- else -%}
    {%- for topic in topics -%}
      {%- assign topic_number = forloop.index -%}
      <div
        class="xo-topics__panel"
        id="XoTopic-{{ section.id }}-{{ topic_number }}"
        {% if use_tabs %}
          role="tabpanel"
          aria-labelledby="XoTopicTab-{{ section.id }}-{{ topic_number }}"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        {% endif %}
        {{ topic.shopify_attributes }}
      >
        {%- if forloop.first -%}
          {{ leading }}
        {%- endif -%}
        {%- assign seen = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'topic' -%}
            {%- assign seen = seen | plus: 1 -%}
          {%- elsif block.type == 'question' and seen == topic_number -%}
            {%- render 'xo-faq-entry', block: block -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if panels contains 'class="xo-qa"' -%}
  <div
    class="xo-topics xo-section xo-tone-{{ s.tone }}"
    {% if s.anchor != blank %}
      id="{{ s.anchor | handleize }}"
      data-xo-anchor
    {% endif %}
  >
    <xo-tabs class="xo-container xo-topics__grid">
      <div class="xo-topics__side">
        {%- render 'xo-section-heading', heading: s.heading, lead: s.lead, rule: false -%}

        {%- if use_tabs -%}
          <div
            class="xo-topics__tabs"
            role="tablist"
            aria-label="{{ 'xo.faq.topics' | t }}"
          >
            {%- for topic in topics -%}
              {%- liquid
                assign is_first = forloop.first
                assign topic_number = forloop.index
                assign count = 0
                if is_first and leading != blank
                  assign count = leading | split: 'class="xo-qa"' | size | minus: 1
                endif
                assign seen = 0
                for block in section.blocks
                  if block.type == 'topic'
                    assign seen = seen | plus: 1
                  elsif block.type == 'question' and seen == topic_number
                    capture entry
                      render 'xo-faq-entry', block: block
                    endcapture
                    if entry != blank
                      assign count = count | plus: 1
                    endif
                  endif
                endfor
              -%}
              <button
                type="button"
                role="tab"
                id="XoTopicTab-{{ section.id }}-{{ topic_number }}"
                aria-controls="XoTopic-{{ section.id }}-{{ topic_number }}"
                aria-selected="{% if is_first %}true{% else %}false{% endif %}"
                {% unless is_first %}
                  tabindex="-1"
                {% endunless %}
              >
                <span>{{ topic.settings.title | escape }}</span>
                <span
                  class="xo-topics__count"
                  aria-hidden="true"
                >
                  {{- count -}}
                </span>
                <span class="xo-visually-hidden">{{ 'xo.faq.count' | t: count: count }}</span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if s.contact_heading != blank -%}
          {%- if whatsapp_url != blank or support_email != blank -%}
            <div class="xo-topics__contact">
              <p class="xo-feature__title">{{ s.contact_heading | escape }}</p>
              <div class="xo-topics__actions">
                {%- if whatsapp_url != blank and s.whatsapp_label != blank -%}
                  <a
                    class="xo-btn xo-btn--solid xo-btn--sm"
                    href="{{ whatsapp_url }}"
                    target="_blank"
                    rel="noopener"
                  >
                    {%- render 'xo-icon', name: 'whatsapp', size: 18 -%}
                    <span>{{ s.whatsapp_label | escape }}</span>
                  </a>
                {%- endif -%}
                {%- if support_email != blank -%}
                  <a
                    class="xo-link"
                    href="mailto:{{ support_email }}"
                  >
                    {{- support_email | escape -}}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="xo-topics__panels">
        {{ panels }}
      </div>
    </xo-tabs>
  </div>

  {%- if use_tabs -%}
    <script
      src="{{ 'xo-tabs.js' | asset_url }}"
      type="module"
    ></script>
  {%- endif -%}

  {%- if s.structured_data -%}
    {%- unless request.design_mode -%}
      {%- render 'xo-faq-jsonld', blocks: section.blocks -%}
    {%- endunless -%}
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .xo-topics__grid {
    display: grid;
    gap: var(--xo-space-7);
  }

  .xo-topics__side {
    display: grid;
    gap: var(--xo-space-6);
    align-content: start;
  }

  .xo-topics__side .xo-heading {
    margin-block-end: 0;
  }

  .xo-topics__tabs {
    display: grid;
    gap: var(--xo-space-2);
  }

  .xo-topics__tabs [role='tab'] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--xo-space-4);
    min-block-size: 3.25rem;
    padding: 0 1.125rem;
    border: 1px solid var(--xo-line-strong);
    border-radius: 12px;
    background: transparent;
    color: var(--xo-fg);
    font: inherit;
    font-weight: 600;
    text-align: start;
    cursor: pointer;
  }

  .xo-topics__tabs [aria-selected='true'] {
    border-color: var(--xo-fg);
    background: var(--xo-fg);
    color: var(--xo-bg);
  }

  .xo-topics__count {
    font-size: var(--xo-text-sm);
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .xo-topics__contact {
    display: grid;
    gap: var(--xo-space-3);
    padding-block-start: var(--xo-space-5);
    border-block-start: 1px solid var(--xo-line-strong);
  }

  .xo-topics__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--xo-space-3) var(--xo-space-5);
  }

  .xo-topics__actions .xo-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--xo-tap-target);
  }

  .xo-topics__panel[hidden] {
    display: none;
  }

  .xo-qa {
    display: grid;
    gap: var(--xo-space-3);
    padding-block: var(--xo-space-6);
    border-block-start: 1px solid var(--xo-line-strong);
  }

  .xo-topics__panel .xo-qa:last-child {
    border-block-end: 1px solid var(--xo-line-strong);
  }

  .xo-qa__q {
    margin: 0;
    color: var(--xo-fg);
    font-family: var(--xo-font-display);
    font-size: var(--xo-text-h4);
    font-weight: var(--xo-font-display-weight);
    letter-spacing: -0.012em;
    line-height: 1.3;
  }

  .xo-qa__a {
    max-inline-size: 40rem;
    color: var(--xo-muted);
    line-height: 1.65;
  }

  @media (min-width: 700px) {
    .xo-qa {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--xo-space-6);
    }
  }

  @media (min-width: 990px) {
    .xo-topics__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 4.5rem;
      align-items: start;
    }

    .xo-topics__side {
      position: sticky;
      inset-block-start: calc(var(--header-height, 4.5rem) + var(--xo-space-6));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.faq",
  "tag": "section",
  "class": "xo-faq-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 24,
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.faq_topics" },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "surface"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "info": "t:xo.info.heading_highlight",
      "default": "Frequently asked <em>questions</em>"
    },
    { "type": "richtext", "id": "lead", "label": "t:xo.labels.lead" },
    { "type": "header", "content": "t:xo.labels.contact_header" },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "t:xo.labels.contact_heading",
      "info": "t:xo.info.faq_contact",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "t:xo.labels.whatsapp_label",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "t:xo.labels.whatsapp_message",
      "default": "Hello, I have a question about Xomoashro shilajit."
    },
    { "type": "header", "content": "t:xo.labels.search_header" },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "t:xo.labels.structured_data",
      "info": "t:xo.info.structured_data",
      "default": true
    },
    { "type": "text", "id": "anchor", "label": "t:xo.labels.anchor", "info": "t:xo.info.anchor" }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "t:xo.names.topic",
      "settings": [
        { "type": "text", "id": "title", "label": "t:xo.labels.title", "default": "The product" }
      ]
    },
    {
      "type": "question",
      "name": "t:xo.names.question",
      "settings": [
        { "type": "text", "id": "question", "label": "t:xo.labels.question", "default": "What is shilajit?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:xo.labels.answer",
          "info": "t:xo.info.fact_text",
          "default": "<p>Shilajit is a natural mineral resin that forms over centuries in high mountain rock.</p>"
        },
        {
          "type": "select",
          "id": "requires",
          "label": "t:xo.labels.requires",
          "info": "t:xo.info.requires",
          "options": [
            { "value": "none", "label": "t:xo.options.requires_none" },
            { "value": "free_shipping", "label": "t:xo.options.requires_free_shipping" },
            { "value": "guarantee", "label": "t:xo.options.requires_guarantee" },
            { "value": "delivery", "label": "t:xo.options.requires_delivery" },
            { "value": "whatsapp", "label": "t:xo.options.requires_whatsapp" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:xo.names.faq",
      "blocks": [
        {
          "type": "topic",
          "settings": { "title": "The product" }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is shilajit?",
            "answer": "<p>Shilajit is a natural mineral resin that forms over centuries in high mountain rock, including the Himalayas. It contains fulvic acid, humic acid and trace minerals, and has been used in traditional medicine for centuries.</p>",
            "requires": "none"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I take shilajit?",
            "answer": "<p>Take a pea-sized amount of resin, dissolve it in warm water, milk or tea, and drink it once a day. Start small and keep to the amount on the label.</p>",
            "requires": "none"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Are there any side effects?",
            "answer": "<p>Most people tolerate shilajit well at the recommended amount. Some may notice an upset stomach. Speak to your doctor before use if you are pregnant, breastfeeding, taking medication or have a health condition.</p>",
            "requires": "none"
          }
        },
        {
          "type": "topic",
          "settings": { "title": "Orders and delivery" }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Orders are delivered within [delivery] working days across Pakistan.</p>",
            "requires": "delivery"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I pay cash on delivery?",
            "answer": "<p>Yes. You can pay in cash when your order arrives, anywhere in Pakistan.</p>",
            "requires": "none"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is there a money-back guarantee?",
            "answer": "<p>Yes. Every order is covered by our [days]-day money-back guarantee. Message us on WhatsApp or email [email] and we will help.</p>",
            "requires": "guarantee"
          }
        }
      ]
    }
  ]
}
{% endschema %}
