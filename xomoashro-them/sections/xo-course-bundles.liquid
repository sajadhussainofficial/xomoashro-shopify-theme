{%- liquid
  assign s = section.settings
  assign product = s.product
  assign first_per_gram = 0
  assign add_fallback = 'xo.bundles.add' | t
  if product != blank
    assign first_variant = product.variants.first
    assign first_weight = first_variant.metafields.custom.net_weight_g.value
    if first_weight != blank and first_weight > 0
      assign first_per_gram = first_variant.price | divided_by: first_weight
    endif
  endif
-%}

{%- if product != blank or request.design_mode -%}
  <div
    class="xo-bundles xo-section xo-tone-{{ s.tone }}"
    {% if s.anchor != blank %}
      id="{{ s.anchor | handleize }}"
      data-xo-anchor
    {% endif %}
  >
    <div class="xo-container">
      {%- render 'xo-section-heading', eyebrow: s.eyebrow, heading: s.heading, lead: s.lead, align: 'center' -%}

      {%- if product != blank -%}
        <ul
          class="xo-bundles__list"
          role="list"
          style="--xo-bundle-count: {{ product.variants.size | at_most: 3 }};"
        >
          {%- for variant in product.variants -%}
            {%- liquid
              assign weight = variant.metafields.custom.net_weight_g.value
              assign supply_days = variant.metafields.custom.supply_days.value
              assign best_for = variant.metafields.custom.best_for.value
              assign badge = variant.metafields.custom.badge.value
              capture per_gram
                render 'xo-per-gram-price', variant: variant
              endcapture

              assign saving = 0
              if first_per_gram > 0 and weight != blank and weight > 0 and forloop.first == false
                assign this_per_gram = variant.price | divided_by: weight
                assign saving = first_per_gram | minus: this_per_gram | times: 100.0 | divided_by: first_per_gram | round
              endif

              assign card_title = variant.title
              if product.has_only_default_variant
                assign card_title = product.title
              endif

              assign media_image = variant.featured_media.preview_image | default: product.featured_media.preview_image
              assign media_url = ''
              if media_image != blank
                assign media_url = media_image | image_url: width: 100
              endif
            -%}
            <li
              class="xo-bundle{% if badge != blank %} xo-bundle--featured{% endif %}"
              data-xo-reveal
              style="--xo-reveal-order: {{ forloop.index0 }};"
            >
              {%- if badge != blank -%}
                <p class="xo-bundle__badge">{{ badge | escape }}</p>
              {%- endif -%}
              <h3 class="xo-h3 xo-bundle__title">{{ card_title | escape }}</h3>
              {%- if supply_days != blank -%}
                <p class="xo-bundle__supply">{{ 'xo.bundles.supply' | t: days: supply_days }}</p>
              {%- endif -%}

              <p class="xo-bundle__price">
                <span class="xo-bundle__amount">{{ variant.price | money }}</span>
                {%- if variant.compare_at_price > variant.price -%}
                  <s class="xo-bundle__compare">
                    <span class="xo-visually-hidden">{{ 'xo.bundles.regular_price' | t }}</span>
                    {{- variant.compare_at_price | money -}}
                  </s>
                {%- endif -%}
              </p>

              <ul
                class="xo-bundle__facts"
                role="list"
              >
                {%- if per_gram != blank and s.show_per_gram -%}
                  <li>{{ 'xo.bundles.per_gram' | t: price: per_gram }}</li>
                {%- endif -%}
                {%- if saving > 0 -%}
                  <li class="xo-bundle__saving">{{ 'xo.bundles.saving' | t: percent: saving }}</li>
                {%- endif -%}
                {%- if best_for != blank -%}
                  <li>{{ 'xo.bundles.best_for' | t: text: best_for }}</li>
                {%- endif -%}
              </ul>

              {%- if variant.available -%}
                <product-form-component
                  class="xo-bundle__form"
                  id="XoBundle-{{ section.id }}-{{ variant.id }}"
                  data-section-id="{{ section.id }}"
                  data-product-id="{{ product.id }}"
                  on:submit="/handleSubmit"
                >
                  <div
                    class="xo-visually-hidden"
                    aria-live="assertive"
                    role="status"
                    aria-atomic="true"
                    ref="liveRegion"
                  ></div>
                  {%- form 'product', product, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input
                      type="hidden"
                      name="id"
                      ref="variantId"
                      value="{{ variant.id }}"
                    >
                    <input
                      type="hidden"
                      name="quantity"
                      value="{{ variant.quantity_rule.min | default: 1 }}"
                    >
                    <add-to-cart-component
                      ref="addToCartButtonContainer"
                      data-product-variant-media="{{ media_url }}"
                      data-add-to-cart-animation="{{ settings.add_to_cart_animation }}"
                    >
                      <button
                        class="xo-btn xo-btn--block{% if badge == blank %} xo-btn--secondary{% endif %}"
                        type="submit"
                        name="add"
                        ref="addToCartButton"
                        on:click="/handleClick"
                        aria-label="{{ 'xo.bundles.add_label' | t: title: card_title }}"
                      >
                        <span>{{ s.button_label | default: add_fallback | escape }}</span>
                      </button>
                    </add-to-cart-component>
                  {%- endform -%}
                </product-form-component>
              {%- else -%}
                <button
                  class="xo-btn xo-btn--block xo-btn--secondary"
                  type="button"
                  disabled
                >
                  {{- 'xo.bundles.sold_out' | t -}}
                </button>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if s.note != blank -%}
          <p class="xo-footnote xo-bundles__note">{{ s.note | escape }}</p>
        {%- endif -%}
      {%- else -%}
        <p class="xo-editor-note">{{ 'xo.bundles.choose_product' | t }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .xo-bundles__list {
    display: grid;
    gap: var(--xo-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .xo-bundles__list {
      grid-template-columns: repeat(var(--xo-bundle-count, 3), minmax(0, 24rem));
      justify-content: center;
      align-items: stretch;
      gap: var(--xo-space-5);
    }
  }

  .xo-bundle {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: var(--xo-space-3);
    padding: var(--xo-space-6) var(--xo-space-5) var(--xo-space-5);
    border: 1px solid var(--xo-line-strong);
    border-radius: var(--xo-radius-card);
    background: var(--xo-surface);
  }

  .xo-bundle--featured {
    border: 2px solid var(--xo-accent);
  }

  .xo-bundle__badge {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--xo-space-5);
    margin: 0;
    padding: 0.25rem 0.75rem;
    border-radius: var(--xo-radius-pill);
    background: var(--xo-accent);
    color: var(--xo-on-accent);
    font-size: var(--xo-text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: translateY(-50%);
  }

  .xo-bundle__supply {
    margin: 0;
    color: var(--xo-muted);
    font-size: var(--xo-text-sm);
  }

  .xo-bundle__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--xo-space-2);
    margin: var(--xo-space-2) 0 0;
  }

  .xo-bundle__amount {
    color: var(--xo-fg);
    font-family: var(--xo-font-display);
    font-size: var(--xo-text-h2);
    font-weight: var(--xo-font-display-weight);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .xo-bundle__compare {
    color: var(--xo-muted);
    font-size: var(--xo-text-base);
  }

  .xo-bundle__facts {
    display: grid;
    gap: var(--xo-space-1);
    align-content: start;
    margin: 0;
    padding: 0;
    color: var(--xo-muted);
    font-size: var(--xo-text-sm);
    line-height: 1.5;
    list-style: none;
  }

  .xo-bundle__saving {
    color: var(--xo-success);
    font-weight: 600;
  }

  .xo-tone-ink .xo-bundle__saving,
  .xo-tone-accent .xo-bundle__saving {
    color: var(--xo-fg);
  }

  .xo-bundle__form {
    display: block;
    margin-block-start: var(--xo-space-3);
  }

  .xo-bundle__form add-to-cart-component {
    display: block;
  }

  .xo-bundles__note {
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:xo.names.bundles",
  "tag": "section",
  "class": "xo-bundles-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    { "type": "paragraph", "content": "t:xo.info.bundles" },
    { "type": "product", "id": "product", "label": "t:xo.labels.product" },
    {
      "type": "select",
      "id": "tone",
      "label": "t:xo.labels.tone",
      "options": [
        { "value": "bone", "label": "t:xo.options.bone" },
        { "value": "surface", "label": "t:xo.options.surface" },
        { "value": "ink", "label": "t:xo.options.ink" },
        { "value": "accent", "label": "t:xo.options.accent" }
      ],
      "default": "bone"
    },
    { "type": "text", "id": "eyebrow", "label": "t:xo.labels.eyebrow", "default": "Choose your size" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:xo.labels.heading",
      "default": "Pure Himalayan Aftabi Shilajit"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:xo.labels.lead",
      "default": "<p>A potent mineral resin formed in the high-altitude Himalayan mountains, sourced above 16,000 ft and prepared with care.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:xo.labels.button_label", "default": "Add to cart" },
    { "type": "checkbox", "id": "show_per_gram", "label": "t:xo.labels.show_per_gram", "default": true },
    {
      "type": "text",
      "id": "note",
      "label": "t:xo.labels.footnote",
      "default": "Cash on delivery available across Pakistan."
    },
    { "type": "text", "id": "anchor", "label": "t:xo.labels.anchor", "info": "t:xo.info.anchor" }
  ],
  "presets": [
    { "name": "t:xo.names.bundles" }
  ]
}
{% endschema %}
